#!/usr/bin/bash
set -euo pipefail

output=$5
mkdir -m 700 -- "$output"
printf '%s\n' '{"schema_version":1,"status":"failed","gate":"fixture-repair-exhaustion","failures":[{"assertion":"fixture_always_rejects","expected":"a patch this fixture accepts","observed":"this fixture accepts none"}],"publish_invoked":false}' >"$output/evidence.json"
printf 'deterministic verifier fixture failed\n' >&2
exit 1
