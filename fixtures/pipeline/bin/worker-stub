#!/usr/bin/bash
set -euo pipefail

output=
task=
fixture_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
while (($#)); do
    case "$1" in
        --output) output=$2; shift 2 ;;
        --task) task=$2; shift 2 ;;
        --bundle|--bundle-sha256|--base-sha|--run-id|--snapshot) shift 2 ;;
        *) exit 64 ;;
    esac
done
test -n "$output"
test -r "$task"
jq -e '.dry_run | type == "boolean"' "$task" >/dev/null
jq -e 'has("untrusted_request") | not' "$task" >/dev/null
mkdir -m 700 -- "$output"
# Keep the packet this attempt was actually given, so a test can assert what a
# repair run was told rather than what the supervisor meant to tell it.
cp -- "$task" "$fixture_root/task-a$(jq -r .attempt "$task").json"
cp -- "$fixture_root/alphabetize.patch" "$output/change.patch"
printf '%s\n' 'Applied the typed sorted-permutation task.' >"$output/rationale.txt"
printf '%s\n' '{"schema_version":1,"claims":[{"id":"sorted-permutation","assertion":"Labels are sorted and values preserved","evidence_ref":"verify-evidence"}],"usage":{"input_tokens":29,"output_tokens":31}}' >"$output/evidence.json"
printf '%s\n' '{"event":"fixture-worker-complete","raw_harness_output":"captured in full"}' >"$output/transcript.jsonl"
