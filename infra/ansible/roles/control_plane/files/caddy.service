[Unit]
Description=Patchyard Factory Caddy edge
After=network-online.target factory-dashboard.service
Wants=network-online.target
Requires=factory-dashboard.service

[Service]
Type=notify
User=caddy
Group=caddy
SupplementaryGroups=factory-web
Environment=HOME=/var/lib/caddy
Environment=XDG_DATA_HOME=/var/lib/caddy
Environment=XDG_CONFIG_HOME=/var/lib/caddy
ExecStart=/usr/local/bin/caddy run --environ --config /etc/caddy/Caddyfile
ExecReload=/usr/local/bin/caddy reload --config /etc/caddy/Caddyfile --force
TimeoutStopSec=10s
LimitNOFILE=1048576
UMask=0027
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
RemoveIPC=true
PrivateTmp=true
PrivateDevices=true
PrivateMounts=true
ProtectHome=true
ProtectSystem=strict
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/caddy /var/log/caddy
InaccessiblePaths=/var/lib/patchyard/artifacts /etc/patchyard

[Install]
WantedBy=multi-user.target
