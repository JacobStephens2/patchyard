[Unit]
Description=Patchyard Factory server-rendered dashboard
After=postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=factory-web
Group=factory-web
SupplementaryGroups=factory
Environment=DATABASE_URL=postgresql:///patchyard?host=/run/patchyard-postgres&user=patchyard_dashboard&sslmode=disable
Environment=FACTORY_DASHBOARD_SOCKET=/run/patchyard-dashboard/dashboard.sock
Environment=FACTORY_INSTALL_ROOT=/opt/patchyard
Environment=FACTORY_ARTIFACT_ROOT=/var/lib/patchyard/artifacts
Environment=FACTORY_IDEAS_PATH=/var/lib/patchyard/proposer-inbox/docs/ideas.md
ExecStart=/usr/local/bin/factory-web
ExecStartPost=+/usr/local/libexec/patchyard-dashboard-socket-owner
Restart=on-failure
RestartSec=5s
RuntimeDirectory=patchyard-dashboard
RuntimeDirectoryMode=0750
UMask=0077
NoNewPrivileges=true
RemoveIPC=true
PrivateTmp=true
PrivateDevices=true
PrivateMounts=true
ProtectHome=true
ProtectSystem=strict
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
ReadWritePaths=/run/patchyard-dashboard /var/lib/patchyard/spool /var/lib/patchyard/artifacts

[Install]
WantedBy=multi-user.target
