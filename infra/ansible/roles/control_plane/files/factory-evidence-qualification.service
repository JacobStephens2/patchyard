[Unit]
Description=Patchyard Factory isolated evidence qualification
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=factory-manager
Group=factory
SupplementaryGroups=factory-manager
ExecStart=/usr/local/bin/factory-evidence-qualify
TimeoutStartSec=120s
KillMode=mixed
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/patchyard/artifacts /run/patchyard-children /run/patchyard-evidence-qualification
RestrictAddressFamilies=AF_UNIX
LockPersonality=true
