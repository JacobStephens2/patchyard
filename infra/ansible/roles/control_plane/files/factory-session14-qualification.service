[Unit]
Description=Patchyard Factory Session 14 lifecycle qualification
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service
Conflicts=factory-supervisor.service

[Service]
Type=oneshot
User=factory-manager
Group=factory
SupplementaryGroups=factory-manager systemd-journal
Environment=DATABASE_URL=postgresql:///patchyard?host=/run/patchyard-postgres&user=patchyard_supervisor&sslmode=disable
EnvironmentFile=/etc/patchyard/supervisor.env
ExecStart=/usr/local/libexec/patchyard-run-session14-qualification
TimeoutStartSec=7200s
TimeoutStopSec=180s
KillSignal=SIGINT
KillMode=mixed
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/patchyard /run/patchyard-children /run/patchyard-session14-qualification
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
