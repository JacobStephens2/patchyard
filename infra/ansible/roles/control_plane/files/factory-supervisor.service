[Unit]
Description=Patchyard Factory durable pipeline supervisor
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=simple
User=factory-manager
Group=factory
SupplementaryGroups=factory-manager systemd-journal
Environment=DATABASE_URL=postgresql:///patchyard?host=/run/patchyard-postgres&user=patchyard_supervisor&sslmode=disable
EnvironmentFile=/etc/patchyard/supervisor.env
ExecStart=/usr/local/bin/factory-supervisor
Restart=on-failure
RestartSec=5s
TimeoutStopSec=90s
KillMode=mixed
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/patchyard /var/lib/patchyard/session9-target /run/patchyard-children /run/patchyard-seats
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true

[Install]
WantedBy=multi-user.target
