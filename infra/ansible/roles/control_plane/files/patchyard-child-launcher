exec {EVIDENCE_HOSTS_FD}<"$JOB/input/hosts"
exec {EVIDENCE_CAPTURE_FD}<"$JOB/input/capture.json"
exec {EVIDENCE_BEARER_FD}<"$JOB/secret/bearer.json"
exec {EVIDENCE_OUTPUT_FD}<"$OUTPUT"
exec {EVIDENCE_PROBE_FD}</usr/local/libexec/patchyard-child-probe
mkdir "$ISOLATION_DIRECTORY"
chown "$NOBODY_UID:$NOBODY_GID" "$ISOLATION_DIRECTORY"
chmod 0700 "$ISOLATION_DIRECTORY"
exec {EVIDENCE_PROBE_OUTPUT_FD}<"$ISOLATION_DIRECTORY"
if ! setsid ip netns exec "$NETNS" env -i PATH=/usr/bin:/bin /usr/bin/bwrap \
  "${BWRAP_BASE[@]}" \
  --share-net \
  --dir /probe-output \
  --ro-bind-fd "$EVIDENCE_HOSTS_FD" /etc/hosts \
  --ro-bind-fd "$EVIDENCE_PROBE_FD" /isolation-probe \
  --bind-fd "$EVIDENCE_PROBE_OUTPUT_FD" /probe-output \
  --chdir /tmp \
  /usr/bin/setpriv \
    --reuid "$NOBODY_UID" --regid "$NOBODY_GID" --clear-groups \
    /isolation-probe /probe-output/isolation.json; then
  require_isolation || true
  exit 1
fi
require_isolation
chown -R root:root "$ISOLATION_DIRECTORY"
chmod 0700 "$ISOLATION_DIRECTORY"
chmod 0600 "$ISOLATION_FILE"
exec {EVIDENCE_PROBE_OUTPUT_FD}>&-
exec {EVIDENCE_PROBE_FD}>&-
setsid ip netns exec "$NETNS" env -i PATH=/usr/bin:/bin /usr/bin/bwrap \
  "${BWRAP_BASE[@]}" \
  --share-net \
  --dir /input \
  --dir /secret \
  --dir /exchange \
  --ro-bind /etc/pki /etc/pki \
  --ro-bind /etc/fonts /etc/fonts \
  --ro-bind-fd "$EVIDENCE_HOSTS_FD" /etc/hosts \
  --ro-bind-fd "$EVIDENCE_CAPTURE_FD" /input/capture.json \
  --ro-bind-fd "$EVIDENCE_BEARER_FD" /secret/bearer.json \
  --ro-bind /usr/local/libexec/patchyard-evidence-child /evidence-child \
  --bind-fd "$EVIDENCE_OUTPUT_FD" /exchange \
  --chdir /tmp \
  /usr/bin/setpriv \
    --reuid "$NOBODY_UID" --regid "$NOBODY_GID" --clear-groups \
    /evidence-child /input/capture.json /secret/bearer.json /exchange/capture \
  >"$OUTPUT/child.stdout" 2>"$OUTPUT/child.stderr" &
CHILD_PID=$!
if ! wait "$CHILD_PID"; then
  CHILD_PID=
  if [[ -f "$OUTPUT/capture/failure.json" && ! -L "$OUTPUT/capture/failure.json" ]]; then
    STATE=$(jq -r '
      if .schema_version == 1
        and (.state | IN(
          "redirect_blocked","cross_origin_blocked","popup_blocked",
          "download_blocked","output_limit_exceeded",
          "bearer_disclosure_blocked","browser_crashed",
          "browser_start_timed_out","child_timed_out",
          "contract_rejected"
        ))
      then .state else "contract_rejected" end
    ' "$OUTPUT/capture/failure.json")
    DIAGNOSTIC=$(jq -r '
      if .diagnostic == "document_2xx" or .diagnostic == "document_3xx"
        or .diagnostic == "document_4xx" or .diagnostic == "document_5xx"
        or .diagnostic == "document_other"
        or .diagnostic == "document_login_form_2xx"
        or .diagnostic == "document_php_error_2xx"
        or .diagnostic == "document_database_error_2xx"
        or .diagnostic == "document_api_denied_2xx"
      then .diagnostic else "document_other" end
    ' "$OUTPUT/capture/failure.json")
    DOCUMENT_STATUS=$(jq -r '
      if (.document_status | type) == "number"
        and .document_status >= 100 and .document_status <= 599
        and (.document_status | floor) == .document_status
      then .document_status else 0 end
    ' "$OUTPUT/capture/failure.json")
    BROWSER_DIAGNOSTIC=$(jq -r '
      if .browser_diagnostic == "browser_pipe_write_failed"
        or .browser_diagnostic == "browser_pipe_closed_running"
        or .browser_diagnostic == "browser_pipe_closed_clean"
        or .browser_diagnostic == "browser_pipe_closed_nonzero"
        or .browser_diagnostic == "browser_pipe_closed_sigtrap"
        or .browser_diagnostic == "browser_pipe_closed_sigsegv"
        or .browser_diagnostic == "browser_pipe_closed_sigabrt"
        or .browser_diagnostic == "browser_pipe_closed_sigkill"
        or .browser_diagnostic == "browser_pipe_closed_signal"
        or .browser_diagnostic == "browser_message_invalid"
        or .browser_diagnostic == "browser_command_rejected"
        or .browser_diagnostic == "browser_command_rejected_browser_version"
        or .browser_diagnostic == "browser_command_rejected_target_create"
        or .browser_diagnostic == "browser_command_rejected_target_attach"
        or .browser_diagnostic == "browser_command_rejected_page_enable"
        or .browser_diagnostic == "browser_command_rejected_runtime_enable"
        or .browser_diagnostic == "browser_command_rejected_network_enable"
        or .browser_diagnostic == "browser_command_rejected_cache_disable"
        or .browser_diagnostic == "browser_command_rejected_service_worker_bypass"
        or .browser_diagnostic == "browser_command_rejected_fetch_enable"
        or .browser_diagnostic == "browser_command_rejected_download_deny"
        or .browser_diagnostic == "browser_command_rejected_navigate"
        or .browser_diagnostic == "browser_command_rejected_runtime_evaluate"
        or .browser_diagnostic == "browser_command_rejected_screenshot"
        or .browser_diagnostic == "browser_event_invalid"
        or .browser_diagnostic == "browser_exception_os"
        or .browser_diagnostic == "browser_exception_subprocess"
        or .browser_diagnostic == "browser_exception_value"
        or .browser_diagnostic == "browser_exception_key"
        or .browser_diagnostic == "browser_exception_type"
        or .browser_diagnostic == "browser_exception_other"
        or .browser_diagnostic == "browser_target_id_invalid"
        or .browser_diagnostic == "browser_session_id_invalid"
        or .browser_diagnostic == "browser_action_result_invalid"
        or .browser_diagnostic == "browser_dom_result_invalid"
        or .browser_diagnostic == "browser_screenshot_result_invalid"
        or .browser_diagnostic == "browser_screenshot_base64_invalid"
      then .browser_diagnostic else "browser_diagnostic_unavailable" end
    ' "$OUTPUT/capture/failure.json")
    printf 'patchyard_child_failure_diagnostic=%s\n' "$DIAGNOSTIC" >&2
    printf 'patchyard_child_failure_document_status=%s\n' "$DOCUMENT_STATUS" >&2
    printf 'patchyard_child_failure_browser_diagnostic=%s\n' \
      "$BROWSER_DIAGNOSTIC" >&2
  else
    STATE=browser_crashed
  fi
  exit 1
fi
CHILD_PID=
FAILURE_STAGE=evidence_output_validation
require_isolation
for name in page.html page.png extract.json hashes.json execution.json; do
  [[ -f "$OUTPUT/capture/$name" && ! -L "$OUTPUT/capture/$name" ]]
  mv -T "$OUTPUT/capture/$name" "$OUTPUT/$name"
  chmod 0600 "$OUTPUT/$name"
done
rmdir "$OUTPUT/capture"
rm -f -- "$OUTPUT/child.stdout" "$OUTPUT/child.stderr"
for name in page.html page.png extract.json hashes.json execution.json; do
  if grep -aFq -- "$BEARER" "$OUTPUT/$name" \
    || grep -aFq -- "$CAPABILITY_ID" "$OUTPUT/$name"; then
    STATE=bearer_disclosure_blocked
    exit 1
  fi
done
STATE=completed
FAILURE_STAGE=none
exit 0
