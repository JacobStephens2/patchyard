[Unit]
Description=Patchyard Factory scoped isolated child %i
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/sbin/patchyard-child-launcher %i
ExecStopPost=/usr/local/sbin/patchyard-reap-child %i
# Bounds the whole child run including a live review seat's provider call
# (seat ceiling 600s); the supervisor-side FACTORY_CHILD_TIMEOUT_SECONDS
# stays above this so the terminal record is what reports the timeout.
TimeoutStartSec=660s
TimeoutStopSec=30s
KillMode=control-group
MemoryMax=768M
TasksMax=512
LimitNOFILE=4096
UMask=0077
NoNewPrivileges=false
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run/patchyard-children /run/netns /run/lock /etc/netns /var/lib/patchyard/supervisor/review-worktrees /var/lib/patchyard/supervisor/proposer-review-worktrees /var/lib/patchyard/supervisor/arbiter-worktrees
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER CAP_KILL CAP_MKNOD CAP_NET_ADMIN CAP_SETGID CAP_SETUID CAP_SYS_ADMIN CAP_SYS_CHROOT
AmbientCapabilities=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER CAP_KILL CAP_MKNOD CAP_NET_ADMIN CAP_SETGID CAP_SETUID CAP_SYS_ADMIN CAP_SYS_CHROOT
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=~user
LockPersonality=true
SystemCallArchitectures=native
