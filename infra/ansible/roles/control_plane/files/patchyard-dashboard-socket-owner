#!/usr/bin/env bash
set -euo pipefail

SOCKET=/run/patchyard-dashboard/dashboard.sock
for _ in $(seq 1 100); do
  if [[ -S "$SOCKET" ]]; then
    chown caddy:factory-web "$SOCKET"
    chmod 0660 "$SOCKET"
    exit 0
  fi
  sleep 0.1
done
echo "factory dashboard socket did not appear within 10 seconds" >&2
exit 1
