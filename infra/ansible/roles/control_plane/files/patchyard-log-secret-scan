#!/usr/bin/env python3
"""Scan bounded control-plane journals for exact preview bearer material."""

from __future__ import annotations

import argparse
import json
from pathlib import Path
import subprocess
import time


MAX_NEEDLES_BYTES = 16 * 1024
MAX_LOG_BYTES = 16 * 1024 * 1024


def read_needles(path: Path) -> list[bytes]:
    metadata = path.lstat()
    if (
        not path.is_file()
        or path.is_symlink()
        or metadata.st_nlink != 1
        or metadata.st_size > MAX_NEEDLES_BYTES
        or metadata.st_mode & 0o077
    ):
        raise ValueError("needle file is unsafe")
    needles = [line for line in path.read_bytes().splitlines() if line]
    if len(needles) != 2 or any(len(needle) < 8 for needle in needles):
        raise ValueError("needle set is invalid")
    return needles


def scan(command: list[str], needles: list[bytes]) -> tuple[int, int]:
    process = subprocess.Popen(
        command,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
    )
    assert process.stdout is not None
    maximum = max(map(len, needles))
    tail = b""
    scanned = 0
    matches = 0
    while True:
        chunk = process.stdout.read(64 * 1024)
        if not chunk:
            break
        scanned += len(chunk)
        if scanned > MAX_LOG_BYTES:
            process.kill()
            process.wait(timeout=10)
            raise RuntimeError("journal scan exceeded its byte ceiling")
        window = tail + chunk
        matches += sum(window.count(needle) for needle in needles)
        tail = window[-maximum:]
    if process.wait(timeout=30) != 0:
        raise RuntimeError("journal source could not be read")
    return scanned, matches


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--needles-file", type=Path, required=True)
    parser.add_argument("--since-unix", type=int, required=True)
    args = parser.parse_args()
    if args.since_unix <= 0 or args.since_unix > int(time.time()):
        raise ValueError("scan start is invalid")
    needles = read_needles(args.needles_file)
    scanned, matches = scan(
        [
            "/usr/bin/journalctl",
            "--since",
            f"@{args.since_unix}",
            "--no-pager",
            "--output=cat",
        ],
        needles,
    )
    print(
        json.dumps(
            {
                "schema_version": 1,
                "sources": 1,
                "bytes_scanned": scanned,
                "matches": matches,
            },
            sort_keys=True,
        )
    )
    return 3 if matches else 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (OSError, RuntimeError, ValueError) as error:
        print(
            json.dumps(
                {
                    "schema_version": 1,
                    "sources": 0,
                    "bytes_scanned": 0,
                    "matches": 0,
                    "error": str(error),
                },
                sort_keys=True,
            )
        )
        raise SystemExit(2)
