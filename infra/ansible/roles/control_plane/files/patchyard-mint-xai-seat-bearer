#!/usr/bin/env python3
"""Stage one xAI team-scoped seat bearer into a supervisor-owned tmpfs stage.

xAI has no workload-identity exchange, so the credential is the A113 clause-3
shape: a key scoped to a dedicated Factory team whose postpaid limit is the
provider-side spend boundary, with the zero-prepaid precondition checked and
recorded at qualification. The key itself lands at qualification as a
root-only file; until it exists this mint fails closed and the arbiter seat
cannot go live, exactly like an unqualified provider in
`policy/provider-egress.json`.
"""

from __future__ import annotations

import grp
import os
from pathlib import Path
import pwd
import re
import stat
import subprocess
import sys


KEY_PATH = Path("/etc/patchyard/xai-seat.key")
SEAT_ROOT = Path("/run/patchyard-seats")
STAGE_PATTERN = re.compile(
    r"agent-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}"
)
BEARER_PATTERN = re.compile(r"xai-[A-Za-z0-9]{16,8000}")


class MintError(RuntimeError):
    """A root boundary or key precondition failed closed."""


def target_identity() -> tuple[int, int]:
    if os.geteuid() != 0:
        raise MintError("seat bearer mint requires a root service context")
    try:
        uid = pwd.getpwnam("factory-manager").pw_uid
        gid = grp.getgrnam("factory").gr_gid
    except KeyError as error:
        raise MintError("seat bearer target identity is absent") from error
    if uid <= 0 or gid <= 0:
        raise MintError("seat bearer target identity is invalid")
    return uid, gid


def validate_output(path: Path, uid: int, gid: int) -> None:
    if (
        not path.is_absolute()
        or path.name != "bearer"
        or path.parent.parent != SEAT_ROOT
        or STAGE_PATTERN.fullmatch(path.parent.name) is None
        or os.path.lexists(path)
    ):
        raise MintError("bearer output path is outside the fixed seat stage")
    try:
        root = SEAT_ROOT.resolve(strict=True)
        stage = path.parent.resolve(strict=True)
        root_metadata = root.lstat()
        stage_metadata = stage.lstat()
        run_metadata = Path("/run").stat()
    except OSError as error:
        raise MintError("seat tmpfs stage cannot be resolved") from error
    if (
        root != SEAT_ROOT
        or stage != path.parent
        or root.is_symlink()
        or stage.is_symlink()
        or not stat.S_ISDIR(root_metadata.st_mode)
        or not stat.S_ISDIR(stage_metadata.st_mode)
        or root_metadata.st_uid != uid
        or stage_metadata.st_uid != uid
        or stage_metadata.st_gid != gid
        or stat.S_IMODE(root_metadata.st_mode) != 0o700
        or stat.S_IMODE(stage_metadata.st_mode) != 0o700
        or stage_metadata.st_dev != run_metadata.st_dev
    ):
        raise MintError("seat tmpfs ownership or permissions are invalid")
    filesystem = subprocess.run(
        ["/usr/bin/stat", "-f", "-c", "%T", "/run"],
        check=True,
        capture_output=True,
        text=True,
        env={"PATH": "/usr/bin:/bin"},
    ).stdout.strip()
    if filesystem != "tmpfs":
        raise MintError("seat credential root is not on tmpfs")


def read_team_key() -> str:
    try:
        metadata = KEY_PATH.lstat()
    except OSError as error:
        raise MintError("xAI seat key is absent") from error
    if (
        KEY_PATH.is_symlink()
        or not stat.S_ISREG(metadata.st_mode)
        or metadata.st_uid != 0
        or metadata.st_gid != 0
        or stat.S_IMODE(metadata.st_mode) != 0o600
        # 8193 admits a trailing newline the strip below removes; the staged
        # bearer itself is bounded to 20..8192.
        or not 20 <= metadata.st_size <= 8193
    ):
        raise MintError("xAI seat key boundary is invalid")
    try:
        bearer = KEY_PATH.read_bytes().decode("ascii").strip()
    except UnicodeDecodeError as error:
        raise MintError("xAI seat key is not ASCII") from error
    if BEARER_PATTERN.fullmatch(bearer) is None:
        raise MintError("xAI seat key type is invalid")
    return bearer


def write_bearer(path: Path, bearer: str, uid: int, gid: int) -> None:
    encoded = bearer.encode("ascii")
    if not 20 <= len(encoded) <= 8192:
        raise MintError("staged bearer is outside the byte limit")
    descriptor: int | None = None
    try:
        descriptor = os.open(
            path,
            os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
            0o600,
        )
        offset = 0
        while offset < len(encoded):
            written = os.write(descriptor, encoded[offset:])
            if written <= 0:
                raise MintError("bearer write made no progress")
            offset += written
        os.fchmod(descriptor, 0o600)
        os.fchown(descriptor, uid, gid)
        os.fsync(descriptor)
    except BaseException:
        if descriptor is not None:
            os.close(descriptor)
            descriptor = None
        try:
            path.unlink()
        except FileNotFoundError:
            pass
        raise
    finally:
        if descriptor is not None:
            os.close(descriptor)
    metadata = path.lstat()
    if (
        path.is_symlink()
        or not stat.S_ISREG(metadata.st_mode)
        or metadata.st_uid != uid
        or metadata.st_gid != gid
        or stat.S_IMODE(metadata.st_mode) != 0o600
        or metadata.st_size != len(encoded)
    ):
        path.unlink(missing_ok=True)
        raise MintError("bearer output postcondition failed")


def run(arguments: list[str]) -> int:
    if len(arguments) != 2 or arguments[0] != "xAI":
        raise MintError("usage: patchyard-mint-xai-seat-bearer xAI OUTPUT")
    uid, gid = target_identity()
    output = Path(arguments[1])
    validate_output(output, uid, gid)
    bearer = ""
    try:
        bearer = read_team_key()
        write_bearer(output, bearer, uid, gid)
    finally:
        bearer = ""
    return 0


if __name__ == "__main__":
    os.umask(0o077)
    try:
        raise SystemExit(run(sys.argv[1:]))
    except (MintError, OSError, subprocess.CalledProcessError) as error:
        del error
        print("seat bearer mint failed closed", file=sys.stderr)
        raise SystemExit(1)
