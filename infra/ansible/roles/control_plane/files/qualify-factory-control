#!/usr/bin/env bash
set -euo pipefail
umask 077

EXPECTED_REVISION=${1:?expected repository revision required}
PRIVATE_IP=${2:?private address required}
CONTROL_PLANE_PRIVATE_CIDR=${3:?control-plane private CIDR required}
QUALIFICATION_TEMP=$(mktemp -d /tmp/patchyard-control-qualification.XXXXXX)
trap 'rm -r -- "$QUALIFICATION_TEMP"' EXIT

systemctl is-active --quiet node-exporter.service
systemctl is-active --quiet postgres-exporter.service
systemctl is-active --quiet postgresql.service
systemctl is-active --quiet patchyard-postgresql-tls-metric.timer
systemctl is-active --quiet patchyard-snapshot-metric.timer
systemctl is-active --quiet factory-supervisor.service
systemctl is-active --quiet factory-dashboard.service
systemctl is-active --quiet caddy.service
test "$(rpm -q chromium)" = chromium-150.0.7871.124-1.el9.x86_64
ss -lntH | grep -Fq "$PRIVATE_IP:9100"
ss -lntH | grep -Fq "$PRIVATE_IP:9187"
ss -lntH | grep -Fq "$PRIVATE_IP:5432"
ss -lntH | grep -Fq "$PRIVATE_IP:9464"
! ss -lntH | grep -Eq '(^|[[:space:]])(0\.0\.0\.0|\*):5432'
firewall-cmd --list-rich-rules | grep -Eq '10\.132\.0\.14/32.*port="9100"'
firewall-cmd --list-rich-rules | grep -Eq '10\.132\.0\.14/32.*port="9187"'
firewall-cmd --list-rich-rules | grep -Eq '10\.132\.0\.14/32.*port="5432"'
firewall-cmd --list-rich-rules | grep -Eq '10\.132\.0\.14/32.*port="9464"'
firewall-cmd --list-rich-rules | grep -Fq "source address=\"$CONTROL_PLANE_PRIVATE_CIDR\" service name=\"ssh\" accept"
test "$(runuser -u factory-manager -- git -C /opt/patchyard rev-parse HEAD)" = \
  "$EXPECTED_REVISION"

FACTORY_GID=$(getent group factory | cut -d: -f3)
IFS=: read -r _ _ FACTORY_WEB_UID FACTORY_WEB_GID _ FACTORY_WEB_HOME FACTORY_WEB_SHELL \
  < <(getent passwd factory-web)
test -n "$FACTORY_GID"
test "$FACTORY_WEB_UID" -lt 1000
test "$FACTORY_WEB_GID" = "$(getent group factory-web | cut -d: -f3)"
test "$FACTORY_WEB_HOME" = /var/lib/patchyard
test "$FACTORY_WEB_SHELL" = /usr/sbin/nologin
id -nG factory-manager | tr ' ' '\n' | grep -Fxq factory
id -nG factory-manager | tr ' ' '\n' | grep -Fxq factory-web
id -nG factory-web | tr ' ' '\n' | grep -Fxq factory
id -nG caddy | tr ' ' '\n' | grep -Fxq factory-web
test "$(getent passwd conductor | cut -d: -f5)" = 'Patchyard orchestration bootstrap and break-glass identity'
test "$(getent passwd factory-manager | cut -d: -f6)" = /var/lib/patchyard-manager
test "$(getent passwd factory-manager | cut -d: -f7)" = /bin/bash
test "$(stat -c '%U:%G:%a' /var/lib/patchyard-manager/.ssh/id_ed25519)" = factory-manager:factory-manager:600
test "$(stat -c '%U:%G:%a' /var/lib/patchyard-manager/.ssh/known_hosts)" = factory-manager:factory-manager:600
grep -Eq '^AllowUsers conductor factory-manager$' /etc/ssh/sshd_config.d/60-patchyard.conf
passwd -S factory-web | grep -Eq '^factory-web (L|LK) '
test ! -e /var/lib/patchyard/.ssh

assert_path() {
  local path=$1 expected_owner=$2 expected_group=$3 expected_mode=$4
  local actual
  actual=$(stat -c '%U:%G:%a' "$path")
  test "$actual" = "$expected_owner:$expected_group:$expected_mode" || {
    echo "$path is $actual; expected $expected_owner:$expected_group:$expected_mode" >&2
    return 1
  }
}

assert_path /var/lib/patchyard root factory 750
assert_path /var/lib/patchyard/artifacts factory-manager factory-web 2750
assert_path /var/lib/patchyard/artifacts/uploads factory-web factory-web 700
assert_path /var/lib/patchyard/supervisor factory-manager factory 700
assert_path /var/lib/patchyard/spool factory-web factory-web 700
assert_path /var/lib/patchyard/worktrees factory-manager factory 750
assert_path /run/patchyard-children factory-manager factory-manager 700
assert_path /run/patchyard-postgres postgres factory 770
assert_path /var/lib/pgsql/patchyard-tls postgres postgres 700
assert_path /var/lib/pgsql/patchyard-tls/server.key postgres postgres 600
assert_path /var/lib/pgsql/patchyard-tls/server.crt postgres postgres 644
assert_path /etc/patchyard/postgresql-server-ca.crt root root 644
assert_path /etc/patchyard/management-inventory.yml root factory-manager 640
assert_path /var/lib/patchyard/snapshots factory-manager factory 700
test -x /usr/local/sbin/build-redacted-snapshot
test -x /usr/local/sbin/check-snapshot-eligibility
test -x /usr/local/sbin/patchyard-run-fixture
test -x /usr/local/sbin/patchyard-run-isolation-probe
test -x /usr/local/sbin/patchyard-run-hostile-qualification
test -x /usr/local/bin/factory-supervisor
test -x /usr/local/bin/factory-web
test -x /bin/curl
gh --version | sed -n '1p' | grep -Eq '^gh version 2\.94\.0 '
test -x /usr/local/libexec/patchyard-git-askpass
test "$(stat -c '%U:%G:%a' /etc/patchyard/github-app.pem)" = 'root:factory-manager:440'
test -x /usr/local/sbin/patchyard-invoke-worker
test -x /usr/local/sbin/patchyard-cleanup-worker
test -x /usr/local/sbin/patchyard-child-launcher
test -x /usr/local/libexec/patchyard-spawn-child
test -x /usr/local/libexec/patchyard-cancel-child
test -x /usr/local/libexec/patchyard-evidence-child
test -x /usr/local/libexec/patchyard-child-probe
test -x /usr/local/libexec/patchyard-deployed-version-unconfigured
test ! -e /usr/local/libexec/patchyard-headless
test ! -e /usr/local/sbin/patchyard-preview-capture
grep -Eq '^patchyard_parity_snapshot_age_days -?[0-9]+$' \
  /var/lib/node_exporter/textfile_collector/patchyard_snapshot.prom
grep -Eq '^patchyard_parity_snapshot_eligible [01]$' \
  /var/lib/node_exporter/textfile_collector/patchyard_snapshot.prom

test "$(postgres --version)" = 'postgres (PostgreSQL) 16.14'
openssl x509 -checkend 2592000 -noout \
  -in /var/lib/pgsql/patchyard-tls/server.crt
openssl verify -CAfile /etc/patchyard/postgresql-server-ca.crt \
  /var/lib/pgsql/patchyard-tls/server.crt
test -S /run/patchyard-postgres/.s.PGSQL.5432
test -S /run/patchyard-dashboard/dashboard.sock
assert_path /run/patchyard-dashboard factory-web factory-web 750
assert_path /run/patchyard-dashboard/dashboard.sock caddy factory-web 660
curl --fail --silent --unix-socket /run/patchyard-dashboard/dashboard.sock \
  http://localhost/healthz | grep -Fxq ok
DASHBOARD_HEADERS="$QUALIFICATION_TEMP/dashboard-headers"
curl --fail --silent --show-error --dump-header "$DASHBOARD_HEADERS" --output /dev/null \
  --unix-socket /run/patchyard-dashboard/dashboard.sock http://localhost/login
tr -d '\r' <"$DASHBOARD_HEADERS" | grep -Eiq \
  "^content-security-policy: default-src 'none'; script-src 'nonce-[A-Za-z0-9_-]+'; style-src 'self'; img-src 'self'; connect-src 'self'; base-uri 'none'; object-src 'none'; form-action 'self'; frame-ancestors 'none'; report-uri /csp-report$"
test "$(curl --silent --show-error --output /dev/null --write-out '%{http_code}' \
  --request POST --header 'Content-Type: application/csp-report' \
  --data '{"csp-report":{"effective-directive":"script-src"}}' \
  --unix-socket /run/patchyard-dashboard/dashboard.sock \
  http://localhost/csp-report)" = 204
/usr/local/bin/caddy validate --config /etc/caddy/Caddyfile
grep -Fq 'factory.example.com {' /etc/caddy/Caddyfile
grep -Fq 'flush_interval -1' /etc/caddy/Caddyfile
grep -Fq 'stream_timeout 0' /etc/caddy/Caddyfile
grep -Fq 'unix//run/patchyard-dashboard/dashboard.sock' /etc/caddy/Caddyfile

test "$(systemctl show factory-dashboard.service --property=User --value)" = factory-web
test "$(systemctl show factory-dashboard.service --property=Group --value)" = factory-web
test "$(systemctl show factory-dashboard.service --property=NoNewPrivileges --value)" = yes
test "$(systemctl show factory-dashboard.service --property=ProtectSystem --value)" = strict
test "$(systemctl show factory-dashboard.service --property=ProtectHome --value)" = yes
test "$(systemctl show factory-dashboard.service --property=PrivateTmp --value)" = yes
test "$(systemctl show factory-dashboard.service --property=PrivateDevices --value)" = yes
test "$(systemctl show factory-dashboard.service --property=RestrictAddressFamilies --value)" = AF_UNIX
systemctl show factory-dashboard.service --property=ReadWritePaths --value \
  | grep -Fq /var/lib/patchyard/artifacts
test "$(systemctl show factory-supervisor.service --property=User --value)" = factory-manager
test "$(systemctl show factory-supervisor.service --property=SupplementaryGroups --value)" = factory-manager
test "$(systemctl show factory-supervisor.service --property=NoNewPrivileges --value)" = yes
test "$(systemctl show factory-supervisor.service --property=ProtectSystem --value)" = strict
systemctl show factory-supervisor.service --property=ReadWritePaths --value \
  | grep -Fq /run/patchyard-children
systemd-analyze verify /etc/systemd/system/patchyard-child@.service
systemctl show patchyard-child@.service --property=ReadWritePaths --value \
  | grep -Fq /var/lib/patchyard/supervisor/review-worktrees
grep -Fq 'subject.user == "factory-manager"' \
  /etc/polkit-1/rules.d/49-patchyard-child.rules
grep -Fq '/^patchyard-child@[0-9a-f]{32}\.service$/' \
  /etc/polkit-1/rules.d/49-patchyard-child.rules
grep -Fq 'action.lookup("verb") == "reset-failed"' \
  /etc/polkit-1/rules.d/49-patchyard-child.rules
test "$(systemctl show caddy.service --property=NoNewPrivileges --value)" = yes
test "$(systemctl show caddy.service --property=ProtectSystem --value)" = strict
test "$(runuser -u postgres -- psql --host=/run/patchyard-postgres \
  --dbname=patchyard --tuples-only --no-align --command='SHOW listen_addresses')" = "$PRIVATE_IP"
test "$(runuser -u postgres -- psql --host=/run/patchyard-postgres \
  --dbname=patchyard --tuples-only --no-align --command='SHOW ssl')" = on
test "$(runuser -u postgres -- psql --host=/run/patchyard-postgres \
  --dbname=patchyard --tuples-only --no-align \
  --command='SELECT count(*) FROM public._sqlx_migrations WHERE success')" = 6

for ROLE in patchyard_migrator patchyard_supervisor patchyard_dashboard grafana_ro patchyard_exporter; do
  test "$(runuser -u postgres -- psql --host=/run/patchyard-postgres \
    --dbname=patchyard --tuples-only --no-align \
    --command="SELECT count(*) FROM pg_authid WHERE rolname = '$ROLE' AND rolcanlogin AND NOT rolsuper AND NOT rolcreatedb AND NOT rolcreaterole AND rolpassword IS NULL")" = 1
done
test "$(runuser -u postgres -- psql --host=/run/patchyard-postgres \
  --dbname=patchyard --tuples-only --no-align \
  --command="SELECT count(*) FROM pg_authid WHERE rolname = 'patchyard_owner' AND NOT rolcanlogin AND NOT rolsuper AND rolpassword IS NULL")" = 1
test "$(runuser -u postgres -- psql --host=/run/patchyard-postgres \
  --dbname=patchyard --tuples-only --no-align \
  --command="SELECT count(*) FROM pg_roles WHERE rolname IN ('patchyard_worker', 'factory_worker')")" = 0

runuser -u factory-manager -- psql --host=/run/patchyard-postgres \
  --username=patchyard_supervisor --dbname=patchyard \
  --set=ON_ERROR_STOP=1 --command='SELECT 1' >/dev/null
runuser -u factory-web -- psql --host=/run/patchyard-postgres \
  --username=patchyard_dashboard --dbname=patchyard \
  --set=ON_ERROR_STOP=1 --command='SELECT 1' >/dev/null
runuser -u postgres_exporter -- psql --host=/run/patchyard-postgres \
  --username=patchyard_exporter --dbname=patchyard \
  --set=ON_ERROR_STOP=1 --command='SELECT 1' >/dev/null

PSQL=(runuser -u postgres -- psql --host=/run/patchyard-postgres \
  --dbname=patchyard --no-psqlrc --set=ON_ERROR_STOP=1)

assert_role_allowed() {
  local role=$1 statement=$2
  "${PSQL[@]}" --command="BEGIN; SET LOCAL ROLE $role; $statement; ROLLBACK" \
    >/dev/null
}

assert_role_denied() {
  local role=$1 statement=$2
  if "${PSQL[@]}" --command="BEGIN; SET LOCAL ROLE $role; $statement; ROLLBACK" \
    >/dev/null 2>&1; then
    echo "$role unexpectedly allowed: $statement" >&2
    return 1
  fi
}

for TABLE in requests runs events artifacts pr_state leases supervisor_state controls; do
  assert_role_allowed patchyard_dashboard "SELECT 1 FROM factory.$TABLE LIMIT 1"
  assert_role_allowed patchyard_supervisor "SELECT 1 FROM factory.$TABLE LIMIT 1"
done
for TABLE in users sessions login_challenges login_attempts audit_events reconcile_requests; do
  assert_role_allowed patchyard_dashboard "SELECT 1 FROM factory.$TABLE LIMIT 1"
done
assert_role_allowed patchyard_supervisor \
  "SELECT 1 FROM factory.reconcile_requests LIMIT 1"
assert_role_allowed patchyard_supervisor \
  "SELECT 1 FROM factory.side_effects LIMIT 1"
assert_role_denied patchyard_dashboard \
  "SELECT 1 FROM factory.side_effects LIMIT 1"
for TABLE in publisher_leases github_state; do
  assert_role_allowed patchyard_supervisor "SELECT 1 FROM factory.$TABLE LIMIT 1"
  assert_role_denied patchyard_dashboard "SELECT 1 FROM factory.$TABLE LIMIT 1"
done
assert_role_allowed patchyard_dashboard \
  "INSERT INTO factory.requests (id, fingerprint, source, body, trace_id) VALUES ('40000000-0000-4000-8000-000000000001', decode(repeat('44', 32), 'hex'), 'qualification', 'dashboard intake', '40000000000000000000000000000001')"
assert_role_allowed patchyard_supervisor \
  "INSERT INTO factory.requests (id, fingerprint, source, body, trace_id) VALUES ('50000000-0000-4000-8000-000000000001', decode(repeat('55', 32), 'hex'), 'qualification', 'supervisor intake', '50000000000000000000000000000001'); INSERT INTO factory.events (request_id, event_type, trace_id) VALUES ('50000000-0000-4000-8000-000000000001', 'qualification', '50000000000000000000000000000001')"
assert_role_allowed patchyard_supervisor \
  "UPDATE factory.requests SET status = status WHERE false"
assert_role_allowed patchyard_supervisor \
  "UPDATE factory.reconcile_requests SET status = status WHERE false"

for STATEMENT in \
  "UPDATE factory.requests SET status = status WHERE false" \
  "DELETE FROM factory.requests WHERE false" \
  "TRUNCATE factory.requests" \
  "INSERT INTO factory.events (request_id, event_type, trace_id) SELECT id, 'forbidden', trace_id FROM factory.requests LIMIT 1" \
  "UPDATE factory.events SET event_type = event_type WHERE false" \
  "DELETE FROM factory.events WHERE false" \
  "CREATE TABLE factory.dashboard_escape(id integer)"; do
  assert_role_denied patchyard_dashboard "$STATEMENT"
done

test "$("${PSQL[@]}" --tuples-only --no-align --command="
  SELECT count(*) FROM factory.users
  WHERE enabled AND NOT password_reset_required AND role='factory_admin'
")" -ge 2
test "$("${PSQL[@]}" --tuples-only --no-align --command="
  SELECT count(*) FROM factory.users
  WHERE enabled AND NOT password_reset_required AND role='factory_submit'
")" -ge 1
for STATEMENT in \
  "UPDATE factory.events SET event_type = event_type WHERE false" \
  "DELETE FROM factory.events WHERE false" \
  "TRUNCATE factory.events" \
  "CREATE TABLE factory.supervisor_escape(id integer)"; do
  assert_role_denied patchyard_supervisor "$STATEMENT"
done

GRAFANA_CANARY=$(
  "${PSQL[@]}" --quiet --tuples-only --no-align --command="
    BEGIN;
    INSERT INTO factory.requests (id, fingerprint, source, body, trace_id)
    VALUES ('60000000-0000-4000-8000-000000000001', decode(repeat('66', 32), 'hex'), 'canary', 'GRAFANA_REQUEST_CANARY_LIVE', '60000000000000000000000000000001');
    INSERT INTO factory.artifacts (id, request_id, path, sha256, kind)
    VALUES ('60000000-0000-4000-8000-000000000002', '60000000-0000-4000-8000-000000000001', 'GRAFANA_ARTIFACT_CANARY_LIVE', decode(repeat('67', 32), 'hex'), 'canary');
    SET LOCAL ROLE grafana_ro;
    SELECT jsonb_build_object(
      'requests', COALESCE((SELECT jsonb_agg(to_jsonb(summary)) FROM factory.grafana_request_summary summary), '[]'::jsonb),
      'runs', COALESCE((SELECT jsonb_agg(to_jsonb(metrics)) FROM factory.grafana_run_metrics metrics), '[]'::jsonb)
    )::text;
    ROLLBACK;"
)
! grep -Fq GRAFANA_REQUEST_CANARY_LIVE <<<"$GRAFANA_CANARY"
! grep -Fq GRAFANA_ARTIFACT_CANARY_LIVE <<<"$GRAFANA_CANARY"
assert_role_denied grafana_ro 'SELECT body FROM factory.requests LIMIT 1'
assert_role_denied grafana_ro 'SELECT path FROM factory.artifacts LIMIT 1'
test "$("${PSQL[@]}" --tuples-only --no-align \
  --command="SELECT count(*) FROM information_schema.role_table_grants WHERE table_schema = 'factory' AND grantee = 'grafana_ro'")" = 0
test "$("${PSQL[@]}" --tuples-only --no-align \
  --command="SELECT count(*) FROM information_schema.column_privileges WHERE table_schema = 'factory' AND grantee = 'grafana_ro'")" = 19

grep -Eq '^patchyard_postgresql_tls_certificate_remaining_seconds [0-9]+$' \
  /var/lib/node_exporter/textfile_collector/patchyard_postgresql_tls.prom
TLS_REMAINING=$(awk '/^patchyard_postgresql_tls_certificate_remaining_seconds / {print $2}' \
  /var/lib/node_exporter/textfile_collector/patchyard_postgresql_tls.prom)
test "$TLS_REMAINING" -gt 2592000
curl --fail --silent --output "$QUALIFICATION_TEMP/postgres.metrics" \
  "http://$PRIVATE_IP:9187/metrics"
grep -Eq '^pg_up 1(\.0)?$' "$QUALIFICATION_TEMP/postgres.metrics"
curl --fail --silent --output "$QUALIFICATION_TEMP/node.metrics" \
  "http://$PRIVATE_IP:9100/metrics"
grep -q '^patchyard_postgresql_tls_certificate_remaining_seconds ' \
  "$QUALIFICATION_TEMP/node.metrics"
curl --fail --silent --output "$QUALIFICATION_TEMP/supervisor.metrics" \
  "http://$PRIVATE_IP:9464/metrics"
grep -Fq '# HELP factory_runs_total Pipeline runs by stage and outcome.' \
  "$QUALIFICATION_TEMP/supervisor.metrics"
grep -Eq '^OTEL_EXPORTER_OTLP_ENDPOINT=$' /etc/patchyard/supervisor.env

/usr/local/bin/caddy version
chromium-browser --version 2>/dev/null || chromium --version
! getent passwd gha-runner >/dev/null
! systemctl list-unit-files --no-legend | grep -Eq 'gha-runner|tempo|otelcol'

echo "control-plane qualification: pass"
