FACTORY_INSTALL_ROOT=/opt/patchyard
FACTORY_RUN_MODE=dry_run
FACTORY_PUBLISH_BRANCH_SUFFIX=change
FACTORY_TARGET_REPOSITORY=/var/lib/patchyard/session9-target
FACTORY_BASE_SHA={{ factory_fieldbook_base_sha }}
FACTORY_ARTIFACT_ROOT=/var/lib/patchyard/artifacts
FACTORY_SCRATCH_ROOT=/var/lib/patchyard/supervisor
FACTORY_SNAPSHOT=/var/lib/patchyard/snapshots/current
FACTORY_WORKER_PROGRAM=/opt/patchyard/fixtures/pipeline/bin/worker-stub
FACTORY_WORKER_CLEANUP=/opt/patchyard/fixtures/pipeline/bin/worker-cleanup-stub
FACTORY_VERIFIER_PROGRAM=/opt/patchyard/fixtures/pipeline/bin/verifier-stub
FACTORY_TRIAGE_HARNESS=/opt/patchyard/fixtures/pipeline/bin/triage-stub
FACTORY_DISPOSITION_HARNESS=/opt/patchyard/fixtures/pipeline/bin/disposition-stub
FACTORY_CHILD_SPAWN_PROGRAM=/usr/local/libexec/patchyard-spawn-child
FACTORY_CHILD_CANCEL_PROGRAM=/usr/local/libexec/patchyard-cancel-child
FACTORY_CHILD_STAGING_ROOT=/run/patchyard-children
FACTORY_CHILD_TIMEOUT_SECONDS=90
FACTORY_PREVIEW_SSH_PROGRAM=/bin/ssh
FACTORY_PREVIEW_SSH_CONFIG=/etc/patchyard/preview-ssh.conf
FACTORY_PREVIEW_SSH_HOST=patchyard-preview
FACTORY_PREVIEW_SSH_HOME=/var/lib/patchyard-manager
FACTORY_PREVIEW_OWNER=factory-supervisor
FACTORY_PREVIEW_LEASE_SECONDS=1800
FACTORY_PREVIEW_CAPABILITY_SECONDS=300
FACTORY_PREVIEW_COMMAND_TIMEOUT_SECONDS=1300
FACTORY_EVIDENCE_PREVIEW_PATH=/mfieldbook/leads/assign.php?rqst_id=96429
FACTORY_EVIDENCE_SELECTORS="#sales_person_id"
FACTORY_CI_WAIT_TIMEOUT_SECONDS=1800
FACTORY_CI_POLL_SECONDS=10
FACTORY_LOG_SECRET_SCAN_PROGRAM=/usr/local/libexec/patchyard-log-secret-scan
FACTORY_LOG_SECRET_SCAN_TIMEOUT_SECONDS=60
FACTORY_BUILDER_CLI_VERSION=fixture-worker/1
FACTORY_TRIAGE_CLI_VERSION=fixture-stub/1
FACTORY_DISPOSITION_CLI_VERSION=fixture-stub/1
FACTORY_METRICS_ADDRESS={{ private_ip }}:9464
FACTORY_REVIEWER_COUNT=2
FACTORY_DAILY_PER_SUBMITTER=5
FACTORY_DAILY_GLOBAL=25
FACTORY_GH_PROGRAM=/bin/gh
FACTORY_CURL_PROGRAM=/bin/curl
FACTORY_GIT_PROGRAM=/bin/git
FACTORY_GIT_ASKPASS=/usr/local/libexec/patchyard-git-askpass
FACTORY_OPENSSL_PROGRAM=/bin/openssl
FACTORY_PUBLISHER_WORKTREE_ROOT=/var/lib/patchyard/worktrees
FACTORY_GITHUB_REPOSITORY_OWNER=example-org
FACTORY_GITHUB_REPOSITORY_NAME=fieldbook
FACTORY_GITHUB_BASE_BRANCH=master
FACTORY_DEPLOYED_VERSION_PROGRAM=/usr/local/libexec/patchyard-deployed-version-unconfigured
FACTORY_DEPLOYED_VERSION_ARGUMENTS_JSON=[]
FACTORY_DEPLOYED_VERSION_TIMEOUT_SECONDS=30
FACTORY_DEPLOYED_VERSION_OUTPUT_BYTES=65536
FACTORY_RECONCILE_ABANDONED_SECONDS=300
FACTORY_RECONCILE_SWEEP_LIMIT=10
# The schedule is wired but remains dormant until stack-council disposition
# A-5 qualifies live-provider egress for the proposer child. Fixture/operator
# qualification enables it explicitly without changing the execution path.
# Starts new scheduled attempts only. Recovery remains active; use full stop
# to prohibit publication effects from durable in-flight proposer work.
FACTORY_PROPOSER_SCHEDULING_ENABLED=false
# This may become true only after master branch protection mechanically
# requires two human approvals for App-authored proposer PRs (A99/F5/F7).
FACTORY_PROPOSER_DUAL_REVIEW_ENFORCED=false
FACTORY_PROPOSER_INTERVAL_SECONDS=86400
FACTORY_PROPOSER_BASE_SHA={{ factory_repo_revision }}
FACTORY_PROPOSER_IDEAS_PATH=/var/lib/patchyard/proposer-inbox/docs/ideas.md
FACTORY_PROPOSER_GITHUB_OWNER=example-org
FACTORY_PROPOSER_GITHUB_REPOSITORY=factory
FACTORY_PROPOSER_BASE_BRANCH=master
FACTORY_PROPOSER_PUBLISHER_LEASE_SECONDS=3600
GH_PATCHYARD_APP_ID={{ factory_github_app_id }}
GH_PATCHYARD_APP_INSTALLATION_ID={{ factory_github_app_installation_id }}
GH_PATCHYARD_APP_SLUG=patchyard
GH_PATCHYARD_APP_PRIVATE_KEY_FILE=/etc/patchyard/github-app.pem
OTEL_EXPORTER_OTLP_ENDPOINT=
