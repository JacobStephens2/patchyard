[Unit]
Description=Patchyard Factory worker private-network egress rejection
After=firewalld.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/apply-worker-egress
ExecReload=/usr/local/sbin/apply-worker-egress
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
