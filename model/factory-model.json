{
  "$schema": "./factory-model.schema.json",
  "schemaVersion": 3,
  "modelVersion": 7,
  "updated": "2026-07-18",
  "rulings": [
    "A39",
    "A47",
    "A49",
    "A50",
    "A52",
    "A57"
  ],
  "topology": {
    "kind": "hierarchical-pipeline",
    "rulings": [
      "A39"
    ]
  },
  "deployment": {
    "phase": "phase-1",
    "controlHost": "orchestration-vm",
    "controlComponents": [
      "supervisor",
      "postgresql",
      "artifact-store",
      "dashboard",
      "publisher"
    ],
    "worker": {
      "host": "dedicated-droplet",
      "components": [
        "implement",
        "verify"
      ],
      "standingSecrets": false,
      "databaseAccess": false,
      "fleetCredentials": false,
      "executionPrivateNetworkAccess": false,
      "runtimeCredential": "short-lived-spend-capped-model-only",
      "executionBoundary": "firecracker-or-rootless-podman"
    },
    "management": {
      "controller": "orchestration-vm",
      "provisioner": "opentofu",
      "configurationManager": "ansible",
      "desiredStateRepository": "factory"
    },
    "rulings": [
      "A57"
    ]
  },
  "actorTypes": {
    "human": "Human judgment - the accountable decision",
    "deterministic": "Ordinary software - same input, same output, no model in the path",
    "agent": "Non-deterministic machine - an AI agent whose output must be verified"
  },
  "lanes": [
    {
      "id": "A",
      "name": "auto-resolve",
      "definition": "Matches a named skill; bounded presentation, report, wording, ordering, or validation fix in internal mfieldbook; acceptance criteria recoverable from the request itself",
      "deliverable": "evidenced-pr"
    },
    {
      "id": "B",
      "name": "needs-spec",
      "definition": "Real feature, over-cap request, or any deny-rule hit",
      "deliverable": "one-page-spec"
    },
    {
      "id": "C",
      "name": "not-code",
      "definition": "Data correction or operations task",
      "deliverable": "human-executed-runbook"
    },
    {
      "id": "D",
      "name": "clarify",
      "definition": "Target or intent not identifiable with confidence",
      "deliverable": "scoped-question"
    }
  ],
  "stages": [
    {
      "num": 0,
      "id": "intake",
      "name": "Intake",
      "summary": "Capture the request verbatim, hash it, and deduplicate it before interpretation",
      "actor": "deterministic",
      "sources": [
        {
          "id": "human-forward",
          "actor": "human",
          "availability": "phase-1"
        },
        {
          "id": "dashboard",
          "actor": "human",
          "availability": "phase-1",
          "rulings": [
            "A32"
          ]
        },
        {
          "id": "mailbox",
          "actor": "deterministic",
          "availability": "phase-2",
          "rulings": [
            "D3"
          ]
        },
        {
          "id": "monitoring",
          "actor": "deterministic",
          "availability": "future"
        }
      ]
    },
    {
      "num": 1,
      "id": "triage",
      "name": "Triage",
      "summary": "Classify against four lanes and the versioned rubric; deny-rules can only demote",
      "actor": "agent"
    },
    {
      "num": 2,
      "id": "implement",
      "name": "Implement",
      "summary": "Produce the smallest coherent diff on the dedicated, credential-free worker droplet",
      "actor": "agent",
      "lanes": [
        "A"
      ]
    },
    {
      "num": 3,
      "id": "verify",
      "name": "Verify",
      "summary": "Run fail-closed gates, deterministic postconditions, tests, and preview evidence",
      "actor": "deterministic"
    },
    {
      "num": 4,
      "id": "approve",
      "name": "Approve",
      "summary": "Engineering reviews the pull request; merge is the approval; nothing merges itself",
      "actor": "human",
      "gate": true
    },
    {
      "num": 5,
      "id": "deploy",
      "name": "Deploy",
      "summary": "Use the existing CI-gated, typed-hostname-confirmed deployment path",
      "actor": "deterministic"
    },
    {
      "num": 6,
      "id": "close",
      "name": "Close the loop",
      "summary": "Record the outcome and draft a reply for a human to send",
      "actor": "deterministic"
    }
  ],
  "entities": [
    {
      "id": "plan",
      "name": "Plan bin",
      "actor": "human",
      "summary": "The decision layer where specifications, runbooks, and clarifications iterate"
    },
    {
      "id": "ledger",
      "name": "Ledger",
      "actor": "deterministic",
      "summary": "Append-only runs and outcomes; every request path can close here"
    },
    {
      "id": "rubric",
      "name": "Rubric",
      "actor": "human",
      "summary": "Versioned classification policy changed only through a reviewed pull request"
    }
  ],
  "edges": [
    {
      "from": "intake",
      "to": "triage",
      "kind": "belt"
    },
    {
      "from": "triage",
      "to": "implement",
      "kind": "belt",
      "label": "lane A"
    },
    {
      "from": "triage",
      "to": "plan",
      "kind": "exit",
      "label": "lanes B, C, D"
    },
    {
      "from": "plan",
      "to": "implement",
      "kind": "human-gated",
      "label": "approved",
      "rulings": [
        "A46"
      ]
    },
    {
      "from": "plan",
      "to": "triage",
      "kind": "human-gated",
      "label": "answered",
      "rulings": [
        "A46"
      ]
    },
    {
      "from": "plan",
      "to": "ledger",
      "kind": "human-gated",
      "label": "binned",
      "rulings": [
        "A48"
      ]
    },
    {
      "from": "implement",
      "to": "verify",
      "kind": "belt"
    },
    {
      "from": "verify",
      "to": "approve",
      "kind": "belt"
    },
    {
      "from": "approve",
      "to": "deploy",
      "kind": "human-gated",
      "label": "approved"
    },
    {
      "from": "approve",
      "to": "implement",
      "kind": "human-gated",
      "label": "changes requested"
    },
    {
      "from": "approve",
      "to": "ledger",
      "kind": "human-gated",
      "label": "rejected"
    },
    {
      "from": "deploy",
      "to": "close",
      "kind": "belt"
    },
    {
      "from": "close",
      "to": "ledger",
      "kind": "belt"
    },
    {
      "from": "ledger",
      "to": "rubric",
      "kind": "learning",
      "label": "learning loop",
      "rulings": [
        "A48"
      ]
    },
    {
      "from": "rubric",
      "to": "triage",
      "kind": "human-gated",
      "label": "policy edit via PR",
      "rulings": [
        "A14"
      ]
    }
  ],
  "macroStages": [
    {
      "id": "plan",
      "name": "Plan",
      "members": [
        "intake",
        "triage",
        "plan"
      ]
    },
    {
      "id": "implement",
      "name": "Implement",
      "members": [
        "implement"
      ]
    },
    {
      "id": "verify",
      "name": "Verify",
      "members": [
        "verify",
        "approve"
      ]
    },
    {
      "id": "aftermath",
      "name": "Aftermath",
      "members": [
        "deploy",
        "close"
      ]
    }
  ],
  "caps": {
    "maxFiles": 2,
    "maxChangedLines": 50,
    "maxOpenPRs": 2,
    "repairLoops": 1
  },
  "approval": {
    "humanGateStage": "approve",
    "requiredRoles": [
      "engineering",
      "owner"
    ],
    "factoryMayMerge": false,
    "rulings": [
      "A33"
    ]
  },
  "phases": [
    {
      "id": 0,
      "name": "Pilot and synthesis",
      "state": "complete"
    },
    {
      "id": 1,
      "name": "Interactive factory",
      "state": "approved-not-started",
      "evidenceGate": {
        "minLaneARuns": 10,
        "minFirstPassMergeRate": 0.7
      }
    },
    {
      "id": 2,
      "name": "Unattended intake",
      "state": "gated",
      "evidenceGate": {
        "acceptancePassK": 3,
        "minCleanRuns": 20,
        "maxMedianReviewMinutes": 5
      }
    },
    {
      "id": 3,
      "name": "Widen on evidence",
      "state": "gated",
      "evidenceGate": {
        "ledgerEvidenceOnly": true
      }
    }
  ],
  "capacity": {
    "throughput": {
      "operator": "min",
      "terms": [
        "demand",
        "agent-capacity",
        "review-capacity"
      ]
    },
    "rulings": [
      "A31"
    ],
    "defaults": {
      "arrivalPerWeek": 20,
      "agentMinPerFix": 20,
      "agentHoursPerWeek": 5,
      "reviewMinPerPR": 10,
      "reviewBudgetMinPerWeek": 60
    }
  }
}
