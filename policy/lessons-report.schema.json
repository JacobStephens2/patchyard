{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factory.example.com/schemas/lessons-report-v1.json",
  "title": "Patchyard Factory deterministic lessons report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "snapshot_max_event_id", "selection", "policy_pr_threshold", "production_run_count", "cohorts", "runs"],
  "properties": {
    "schema_version": {"const": 1},
    "snapshot_max_event_id": {"type": "integer", "minimum": 0},
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_class", "terminal_runs_only", "quote_sources", "max_quotes_per_run", "max_quotes_per_report", "max_quote_chars"],
      "properties": {
        "run_class": {"const": "production"},
        "terminal_runs_only": {"const": true},
        "quote_sources": {
          "const": [{"event_type": "run.killed", "json_pointer": "/reason", "trust": "untrusted_operator_quote"}]
        },
        "max_quotes_per_run": {"const": 1},
        "max_quotes_per_report": {"const": 32},
        "max_quote_chars": {"const": 240}
      }
    },
    "policy_pr_threshold": {"const": 10},
    "production_run_count": {"type": "integer", "minimum": 0},
    "cohorts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cohort_key", "lane", "skill", "rubric_sha256", "prompt_template_sha256", "routing_config_version", "production_run_count", "eligible_for_policy_pr", "run_ids", "outcomes"],
        "properties": {
          "cohort_key": {"type": "string", "pattern": "^cohort:[0-9a-f]{64}$"},
          "lane": {"type": "string", "minLength": 1},
          "skill": {"type": "string", "minLength": 1, "maxLength": 128},
          "rubric_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "prompt_template_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "routing_config_version": {"type": "string", "minLength": 1, "maxLength": 256},
          "production_run_count": {"type": "integer", "minimum": 1},
          "eligible_for_policy_pr": {"type": "boolean"},
          "run_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "format": "uuid"}
          },
          "outcomes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["terminal_state", "count", "rate_basis_points"],
              "properties": {
                "terminal_state": {"type": "string", "minLength": 1},
                "count": {"type": "integer", "minimum": 1},
                "rate_basis_points": {"type": "integer", "minimum": 0, "maximum": 10000}
              }
            }
          }
        }
      }
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["run_id", "request_id", "run_class", "lane", "skill", "rubric_sha256", "prompt_template_sha256", "routing_config_version", "terminal_state", "queued_at", "started_at", "finished_at", "duration_ms", "quotes"],
        "properties": {
          "run_id": {"type": "string", "format": "uuid"},
          "request_id": {"type": "string", "format": "uuid"},
          "run_class": {"const": "production"},
          "lane": {"type": "string", "minLength": 1},
          "skill": {"type": "string", "minLength": 1, "maxLength": 128},
          "rubric_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "prompt_template_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "routing_config_version": {"type": "string", "minLength": 1, "maxLength": 256},
          "terminal_state": {"type": "string", "minLength": 1},
          "queued_at": {"type": "string", "format": "date-time"},
          "started_at": {"type": ["string", "null"], "format": "date-time"},
          "finished_at": {"type": "string", "format": "date-time"},
          "duration_ms": {"type": ["integer", "null"], "minimum": 0},
          "quotes": {
            "type": "array",
            "maxItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["event_id", "event_type", "json_pointer", "trust", "source_sha256", "start_char", "end_char", "text", "truncated"],
              "properties": {
                "event_id": {"type": "integer", "minimum": 1},
                "event_type": {"const": "run.killed"},
                "json_pointer": {"const": "/reason"},
                "trust": {"const": "untrusted_operator_quote"},
                "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "start_char": {"const": 0},
                "end_char": {"type": "integer", "minimum": 0, "maximum": 240},
                "text": {"type": "string", "maxLength": 240},
                "truncated": {"type": "boolean"}
              }
            }
          }
        }
      }
    }
  }
}
