{
  "schema_version": 1,
  "purpose": "Per-provider facts consumed by the A133 provider-neutral launcher (worker/runtime/patchyard-provider-run) for credential-bearing qualification runs. The launcher carries the structure; every provider-shaped value lives here. provider-egress.json remains the sole egress authority: a provider entry here is meaningful only for a provider that also exists there, and the launcher reads hostnames exclusively from the egress policy.",
  "providers": {
    "anthropic": {
      "one_shot_client": "/usr/local/libexec/patchyard-anthropic-one-shot",
      "authorization_ruling": "A115",
      "phase_spend_cap_cents": {
        "temporary_refusal": 100,
        "operational_acceptance": 5000,
        "restored_acceptance": 5000
      },
      "capability_field_patterns": {
        "secret": "^sk-ant-oat01-[A-Za-z0-9_-]+$",
        "scope": "^workspace:inference$",
        "exchange_request_id": "^req_[A-Za-z0-9]+$",
        "service_account_id": "^svac_[A-Za-z0-9]+$",
        "rule_id": "^fdrl_[A-Za-z0-9]+$",
        "workspace_id": "^wrkspc_[A-Za-z0-9]+$"
      }
    },
    "openai": {
      "one_shot_client": "/usr/local/libexec/patchyard-openai-one-shot",
      "authorization_ruling": "A132",
      "phase_spend_cap_cents": {
        "temporary_refusal": 0,
        "operational_acceptance": 0,
        "restored_acceptance": 0
      },
      "capability_field_patterns": {
        "secret": "^[A-Za-z0-9._-]{20,4096}$",
        "scope": "^unscoped$",
        "exchange_request_id": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "service_account_id": "^user-[A-Za-z0-9]{16,48}$",
        "rule_id": "^idp_[A-Za-z0-9]{16,48}$",
        "workspace_id": "^proj_[A-Za-z0-9]{16,48}$"
      }
    }
  }
}
