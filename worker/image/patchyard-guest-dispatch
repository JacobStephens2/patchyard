#!/usr/bin/env bash
set -euo pipefail
umask 077

# Route by the shape of the input drive, never by a provider name.
#
# The qualification runner and the general run runner are separate programs
# because the general one is pinned byte-identical by the checkers that guard
# already-banked evidence. This dispatcher is ordered ahead of that runner's
# unit and decides which of the two owns the boot:
#
#   qualification-policy.json present -> exec the qualification runner, which
#     completes the run and powers the guest off, so the general runner never
#     starts;
#   absent -> exit 0 and leave the general runner to run exactly as it did
#     before this program existed.
#
# It peeks at a read-only mount and unmounts before handing over, so the
# runner it hands to performs its own mount sequence unchanged.

INPUT_DEVICE=/dev/disk/by-label/ETA_INPUT
PEEK_ROOT=/run/patchyard-dispatch-input
QUALIFICATION_RUNNER=/usr/local/sbin/patchyard-guest-qualify
ROUTE=general

for _ in $(seq 1 100); do
  [[ -e "$INPUT_DEVICE" ]] && break
  sleep 0.05
done
# A missing input drive is the general runner's failure to report: it owns the
# result drive and the bounded failure vocabulary. Never pre-empt that here.
[[ -e "$INPUT_DEVICE" ]] || exit 0

install -d -m 0700 "$PEEK_ROOT"
mount -o ro,nosuid,nodev,noexec "$INPUT_DEVICE" "$PEEK_ROOT"
if [[ -f "$PEEK_ROOT/qualification-policy.json" \
  && ! -L "$PEEK_ROOT/qualification-policy.json" ]]; then
  ROUTE=qualification
fi
umount "$PEEK_ROOT"
rmdir "$PEEK_ROOT"

[[ "$ROUTE" == qualification ]] || exit 0
[[ -x "$QUALIFICATION_RUNNER" && ! -L "$QUALIFICATION_RUNNER" ]]
exec "$QUALIFICATION_RUNNER"
