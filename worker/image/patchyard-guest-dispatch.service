[Unit]
Description=Patchyard Factory one-run qualification dispatch
After=local-fs.target systemd-udev-settle.service
Wants=systemd-udev-settle.service
Before=patchyard-guest-run.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/patchyard-guest-dispatch
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
