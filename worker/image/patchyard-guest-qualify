#!/usr/bin/env bash
set -euo pipefail
umask 077

# Provider-neutral spend-enforcement qualification runner.
#
# The work is receipt validation, not a provider call: the host holds the sole
# transport (A117), performs the one billable request outside this guest, and
# stages three receipts on the read-only input drive. This program re-checks
# them from inside a guest that holds no credential and no provider route, then
# emits the patch and evidence the host result contract consumes.
#
# Every provider-shaped value - endpoint, response vocabulary, identifier
# patterns, artifact naming, ruling id - arrives as data in
# /input/qualification-policy.json, sha-bound by the manifest. This file
# carries the structure and no provider name, the same division A133 ruled for
# the launcher.

RESULT_MOUNTED=false
INPUT_MOUNTED=false
WORK_MOUNTED=false
STATUS=error
FAILURE=qualification-runner-failed

poweroff_guest() {
  sync
  systemctl reboot --force --force >/dev/null 2>&1 || reboot -f
}

finish() {
  local rc=$?
  set +e
  if $RESULT_MOUNTED; then
    if [[ "$STATUS" != success ]]; then
      printf '%s\n' "$FAILURE" >/result/status
    fi
    sync /result
  fi
  $WORK_MOUNTED && umount /work
  $INPUT_MOUNTED && umount /input
  $RESULT_MOUNTED && umount /result
  poweroff_guest
  exit "$rc"
}
trap finish EXIT

for label in ETA_INPUT ETA_WORK ETA_RESULT; do
  for _ in $(seq 1 100); do
    [[ -e "/dev/disk/by-label/$label" ]] && break
    sleep 0.05
  done
  [[ -e "/dev/disk/by-label/$label" ]] || {
    FAILURE="missing-drive-$label"
    exit 1
  }
done

install -d -m 0755 /input /work /result
mount -o ro,nosuid,nodev,noexec /dev/disk/by-label/ETA_INPUT /input
INPUT_MOUNTED=true
mount -o rw,nosuid,nodev,noexec /dev/disk/by-label/ETA_WORK /work
WORK_MOUNTED=true
chown factory-agent:factory-agent /work
mount -o rw,nosuid,nodev,noexec /dev/disk/by-label/ETA_RESULT /result
RESULT_MOUNTED=true

FAILURE=qualification-manifest-rejected
MANIFEST=/input/run.json
POLICY=/input/qualification-policy.json
jq -e '
  .schema_version == 1
  and (.run_id | test("^[a-z0-9][a-z0-9-]{0,62}$"))
  and (.base_sha | test("^[0-9a-f]{40}$"))
  and (.source_archive_sha256 | test("^[0-9a-f]{64}$"))
  and (.request_sha256 | test("^[0-9a-f]{64}$"))
  and (.snapshot_sql_sha256 | test("^[0-9a-f]{64}$"))
  and (.snapshot_manifest_sha256 | test("^[0-9a-f]{64}$"))
  and (.host_contract_sha256 | test("^[0-9a-f]{64}$"))
  and (.qualification_policy_sha256 | test("^[0-9a-f]{64}$"))
  and .mode == "provider-qualification"
  and .qualification_requirement == "provider-spend-enforcement"
  and .credential_required == true
  and (.provider | test("^[a-z0-9][a-z0-9-]{0,31}$"))
  and (.qualification_phase | test("^[a-z_]{1,64}$"))
  and (.spend_cap_cents | type == "number" and . >= 0)
' "$MANIFEST" >/dev/null

RUN_ID=$(jq -r .run_id "$MANIFEST")
BASE_SHA=$(jq -r .base_sha "$MANIFEST")
REQUEST_SHA=$(jq -r .request_sha256 "$MANIFEST")
SNAPSHOT_SQL_SHA=$(jq -r .snapshot_sql_sha256 "$MANIFEST")
SNAPSHOT_MANIFEST_SHA=$(jq -r .snapshot_manifest_sha256 "$MANIFEST")
PROVIDER=$(jq -r .provider "$MANIFEST")
HOST_CONTRACT_SHA=$(jq -r .host_contract_sha256 "$MANIFEST")
QUALIFICATION_PHASE=$(jq -r .qualification_phase "$MANIFEST")
SPEND_CAP_CENTS=$(jq -r .spend_cap_cents "$MANIFEST")
POLICY_SHA=$(jq -r .qualification_policy_sha256 "$MANIFEST")

FAILURE=qualification-policy-rejected
[[ -f "$POLICY" && ! -L "$POLICY" ]]
[[ "$(sha256sum "$POLICY" | cut -d' ' -f1)" == "$POLICY_SHA" ]]
jq -e --arg provider "$PROVIDER" --arg phase "$QUALIFICATION_PHASE" '
  .schema_version == 1
  and .provider == $provider
  and .qualification_requirement == "provider-spend-enforcement"
  and (.authorization_ruling | test("^A[0-9]{1,4}$"))
  and (.endpoint | test("^/[A-Za-z0-9/._-]{1,128}$"))
  and (.cap_field | test("^[a-z_]{1,64}$"))
  and (.request_id_required | type == "boolean")
  and (.request_id_pattern | type == "string" and length <= 128)
  and (.issuance_field_patterns
    | (keys | sort) == ["exchange_request_id","rule_id","scope",
        "service_account_id","workspace_id"]
    and (to_entries | all(.value | type == "string" and length <= 128)))
  and (.accepted_response
    | (keys | sort) == ["model","response_type","usage_fields"]
    and (.model | type == "string" and length <= 128)
    and (.response_type | type == "string" and length <= 64)
    and (.usage_fields | type == "array" and length == 2
      and all(type == "string" and test("^[a-z_]{1,64}$"))))
  and (.refusal_response
    | (keys | sort) == ["enforced","error_type_pattern","excluded_error_types",
        "http_status","response_type","unenforced_basis"]
    and (.enforced | type == "boolean")
    and (if .enforced then
      (.http_status | type == "array" and length >= 1
        and all(type == "number" and . >= 400 and . <= 599))
      and (.response_type | type == "string" and length <= 64)
      and (.error_type_pattern | type == "string" and length <= 128)
      and (.excluded_error_types | type == "array"
        and all(type == "string" and test("^[a-z_]{1,64}$")))
      and .unenforced_basis == null
    else
      .http_status == null and .response_type == null
      and .error_type_pattern == null and .excluded_error_types == null
      and (.unenforced_basis | type == "string" and test("^[a-z0-9-]{1,96}$"))
    end))
  and (.work_artifact
    | (keys | sort) == ["content","path"]
    and (.path | test("^[a-z0-9][a-z0-9._-]{0,63}$"))
    and (.content | test("^[a-z0-9][a-z0-9 ._-]{0,127}$")))
  and (.rationale | type == "string" and length >= 32 and length <= 1024)
  and (.phases | type == "array" and length >= 1 and index($phase) != null)
' "$POLICY" >/dev/null

RULING=$(jq -r .authorization_ruling "$POLICY")
ENDPOINT=$(jq -r .endpoint "$POLICY")
REFUSAL_ENFORCED=$(jq -r .refusal_response.enforced "$POLICY")
WORK_ARTIFACT=$(jq -r .work_artifact.path "$POLICY")
WORK_CONTENT=$(jq -r .work_artifact.content "$POLICY")
RATIONALE=$(jq -r .rationale "$POLICY")

FAILURE=qualification-input-rejected
[[ "$(sha256sum /input/request.md | cut -d' ' -f1)" == "$REQUEST_SHA" ]]
[[ "$(sha256sum /input/snapshot.sql.gz | cut -d' ' -f1)" == "$SNAPSHOT_SQL_SHA" ]]
[[ "$(sha256sum /input/snapshot.json | cut -d' ' -f1)" == "$SNAPSHOT_MANIFEST_SHA" ]]
[[ "$(</work/.patchyard-base-sha)" == "$BASE_SHA" ]]
[[ -d /work/.git ]]
[[ -f /work/base.txt ]]
WORK_REMOTES=$(runuser -u factory-agent -- git -C /work remote)
WORK_STATUS=$(runuser -u factory-agent -- git -C /work status --porcelain)
[[ -z "$WORK_REMOTES" ]]
[[ -z "$WORK_STATUS" ]]

IMAGE_MANIFEST=/input/image.json
jq -e '
  .schema_version == 1
  and (.rootfs_sha256 | test("^[0-9a-f]{64}$"))
  and (.image_recipe_sha256 | test("^[0-9a-f]{64}$"))
  and (.production_parity_sha256 | test("^[0-9a-f]{64}$"))
' "$IMAGE_MANIFEST" >/dev/null
ROOTFS_SHA=$(jq -r .rootfs_sha256 "$IMAGE_MANIFEST")
IMAGE_RECIPE_SHA=$(jq -r .image_recipe_sha256 "$IMAGE_MANIFEST")
PRODUCTION_PARITY_SHA=$(jq -r .production_parity_sha256 "$IMAGE_MANIFEST")

# The credential never reaches this guest, and neither does a route to the
# provider: both are the host's, and their absence here is part of what the
# evidence claims.
FAILURE=qualification-boundary-rejected
[[ ! -e /dev/disk/by-label/ETA_CREDENTIAL ]]
[[ ! -e /run/patchyard-capability ]]
[[ ! -s /input/provider-hosts ]]
[[ -f /input/issuance.json && ! -L /input/issuance.json ]]
[[ -f /input/provider-observation.json && ! -L /input/provider-observation.json ]]
[[ -f /input/provider-transport.json && ! -L /input/provider-transport.json ]]

FAILURE=qualification-issuance-receipt-rejected
jq -e --slurpfile policy "$POLICY" '
  ($policy[0].issuance_field_patterns) as $patterns
  | (keys | sort) == ["exchange_request_id","expires_at","expires_in","issued_at",
      "rule_id","scope","service_account_id","token_type","workspace_id"]
  and (.issued_at | fromdateiso8601 | type == "number")
  and (.expires_at | fromdateiso8601 | type == "number")
  and (.expires_in | type == "number" and . >= 60 and . <= 300)
  and .token_type == "Bearer"
  and (.scope | test($patterns.scope))
  and (.exchange_request_id | test($patterns.exchange_request_id))
  and (.service_account_id | test($patterns.service_account_id))
  and (.rule_id | test($patterns.rule_id))
  and (.workspace_id | test($patterns.workspace_id))
' /input/issuance.json >/dev/null

# The transport receipt is provider-independent: A117 fixes the one-shot
# mechanism, and these values are the host's own counters, not the provider's.
FAILURE=qualification-transport-receipt-rejected
jq -e '
  (keys | sort) == ["admitted_conntrack_ids","admitted_new_connections",
    "authorization_ruling","client_sha256","connection_close",
    "credential_removed_before_guest_boot","guest_provider_allowlist_entries",
    "http_version","mechanism","namespace_ipv6_disabled","rejected_connection_packets",
    "rejected_new_connections","schema_version"]
  and .schema_version == 1 and .authorization_ruling == "A117"
  and .mechanism == "host-one-shot-network-namespace-v1"
  and .http_version == "1.0" and .connection_close == true
  and .admitted_conntrack_ids == 1 and .admitted_new_connections == 1
  and .rejected_new_connections == 0 and .rejected_connection_packets == 0
  and .guest_provider_allowlist_entries == 0
  and .namespace_ipv6_disabled == true
  and .credential_removed_before_guest_boot == true
  and (.client_sha256 | test("^[0-9a-f]{64}$"))
' /input/provider-transport.json >/dev/null

FAILURE=qualification-observation-receipt-rejected
jq -e --slurpfile policy "$POLICY" --arg phase "$QUALIFICATION_PHASE" \
  --argjson cap "$SPEND_CAP_CENTS" '
  $policy[0] as $p
  | .[$p.cap_field] == $cap
  and .endpoint == $p.endpoint
  and .request_attempts == 1
  and (.observed_at | fromdateiso8601 | type == "number")
  and (.request_body_sha256 | test("^[0-9a-f]{64}$"))
  and (if $p.request_id_required then
    (.request_id | type == "string" and test($p.request_id_pattern))
  else
    (.request_id == null or (.request_id | test($p.request_id_pattern)))
    and (.request_id_supplied | type == "boolean")
    and (.request_id_supplied == (.request_id != null))
  end)
  and (if $phase == "temporary_refusal" then
    .outcome == "refused"
    and (if $p.refusal_response.enforced then
      # The refusal shape was observed once and is held to it thereafter.
      ([.http_status] | inside($p.refusal_response.http_status))
      and .response_type == $p.refusal_response.response_type
      and (.provider_error.error_type | test($p.refusal_response.error_type_pattern))
      and ([.provider_error.error_type]
        | inside($p.refusal_response.excluded_error_types) | not)
    else
      # A125: no refusal from this provider has been observed, so nothing
      # about the response is required beyond the bounds the host applied.
      # What IS required is that the record says so, in the same run that
      # produced it - an unenforced predicate must never read as a met one.
      .response_predicate.enforced == false
      and .response_predicate.basis == $p.refusal_response.unenforced_basis
      and (.http_status | type == "number")
    end)
  else
    # Token counts are checked against their policy-named fields below, where
    # the field names can index the usage object directly.
    .outcome == "accepted" and .http_status == 200
    and .response_type == $p.accepted_response.response_type
    and .model == $p.accepted_response.model
    and (.usage | type == "object")
  end)
' /input/provider-observation.json >/dev/null

if [[ "$QUALIFICATION_PHASE" != temporary_refusal ]]; then
  jq -e --slurpfile policy "$POLICY" '
    .usage as $usage
    | $policy[0].accepted_response.usage_fields
    | all($usage[.] | type == "number" and . >= 1)
  ' /input/provider-observation.json >/dev/null
fi

# The billable request must fall inside the bearer's own five-minute life, or
# the receipts describe two different credentials.
jq -e --slurpfile issuance /input/issuance.json '
  ($issuance[0].issued_at | fromdateiso8601) <= (.observed_at | fromdateiso8601)
  and (.observed_at | fromdateiso8601) < ($issuance[0].expires_at | fromdateiso8601)
' /input/provider-observation.json >/dev/null

FAILURE=qualification-patch-failed
printf '%s\n' "$WORK_CONTENT" >"/work/$WORK_ARTIFACT"
chown factory-agent:factory-agent "/work/$WORK_ARTIFACT"
runuser -u factory-agent -- git -C /work add -N .
runuser -u factory-agent -- git -C /work diff --binary --full-index \
  >/result/change.patch
[[ -s /result/change.patch ]]
printf '%s\n' "$RATIONALE" >/result/rationale.txt

FAILURE=qualification-evidence-failed
PATCH_SHA=$(sha256sum /result/change.patch | cut -d' ' -f1)
ISSUANCE=$(jq -c . /input/issuance.json)
PROVIDER_OBSERVATION=$(jq -c . /input/provider-observation.json)
PROVIDER_TRANSPORT=$(jq -c . /input/provider-transport.json)
jq -n \
  --arg run_id "$RUN_ID" --arg base_sha "$BASE_SHA" \
  --arg request_sha256 "$REQUEST_SHA" --arg patch_sha256 "$PATCH_SHA" \
  --arg provider "$PROVIDER" \
  --arg authorization_ruling "$RULING" \
  --arg qualification_phase "$QUALIFICATION_PHASE" \
  --arg observed_rootfs_sha256 "$ROOTFS_SHA" \
  --arg image_recipe_sha256 "$IMAGE_RECIPE_SHA" \
  --arg production_parity_sha256 "$PRODUCTION_PARITY_SHA" \
  --arg host_contract_sha256 "$HOST_CONTRACT_SHA" \
  --arg qualification_policy_sha256 "$POLICY_SHA" \
  --arg endpoint "$ENDPOINT" \
  --argjson refusal_predicate_enforced "$REFUSAL_ENFORCED" \
  --argjson issuance "$ISSUANCE" \
  --argjson provider_observation "$PROVIDER_OBSERVATION" \
  --argjson provider_transport "$PROVIDER_TRANSPORT" \
  '{schema_version:1,$run_id,$base_sha,$request_sha256,$provider,
    qualification_requirement:"provider-spend-enforcement",
    $authorization_ruling,$qualification_phase,$patch_sha256,
    $observed_rootfs_sha256,$image_recipe_sha256,$production_parity_sha256,
    git_remote_count:0,$host_contract_sha256,$qualification_policy_sha256,
    credential_removed_before_output:true,
    $issuance,
    delivery:{worker_host_tmpfs:true,credential_delivered_to_guest:false,
      credential_removed_before_guest_boot:true,assertion_delivered:false,
      signing_key_delivered:false,admin_credential_delivered:false},
    $provider_transport,$provider_observation,
    observation_predicate:{$endpoint,$refusal_predicate_enforced}}' \
  >/result/evidence.json
printf 'success\n' >/result/status
STATUS=success
FAILURE=
