#!/usr/bin/env bash
set -euo pipefail
umask 077

RESULT_MOUNTED=false
INPUT_MOUNTED=false
WORK_MOUNTED=false
WEBROOT_MOUNTED=false
STATUS=error
FAILURE=guest-runner-failed
CAPABILITY_FILE=
PROVIDER_TEMP=

remove_provider_credential() {
  local cleanup_failed=0
  if mountpoint -q /credential; then
    umount /credential || cleanup_failed=1
  fi
  if [[ -n "$PROVIDER_TEMP" ]]; then
    rm -rf -- "$PROVIDER_TEMP" || cleanup_failed=1
    [[ ! -e "$PROVIDER_TEMP" && ! -L "$PROVIDER_TEMP" ]] || cleanup_failed=1
  fi
  rm -rf -- /run/patchyard-capability || cleanup_failed=1
  [[ ! -e /run/patchyard-capability \
    && ! -L /run/patchyard-capability ]] || cleanup_failed=1
  CAPABILITY_FILE=
  PROVIDER_TEMP=
  return "$cleanup_failed"
}

classify_anthropic_error_shape() {
  if ! jq -e 'type == "object"' "$PROVIDER_RESPONSE" >/dev/null 2>&1; then
    printf 'non-object\n'
  elif ! jq -e 'has("type")' "$PROVIDER_RESPONSE" >/dev/null; then
    printf 'missing-type\n'
  elif ! jq -e '.type == "error"' "$PROVIDER_RESPONSE" >/dev/null; then
    printf 'type-not-error\n'
  elif ! jq -e 'has("error")' "$PROVIDER_RESPONSE" >/dev/null; then
    printf 'missing-error\n'
  elif ! jq -e '.error | type == "object"' "$PROVIDER_RESPONSE" >/dev/null; then
    printf 'error-not-object\n'
  elif ! jq -e '.error | has("type")' "$PROVIDER_RESPONSE" >/dev/null; then
    printf 'missing-error-type\n'
  elif ! jq -e '.error | has("message")' "$PROVIDER_RESPONSE" >/dev/null; then
    printf 'missing-error-message\n'
  elif ! jq -e '.error.type | type == "string" and test("^[a-z_]{1,64}$")' \
    "$PROVIDER_RESPONSE" >/dev/null; then
    printf 'invalid-error-type\n'
  elif ! jq -e '.error.message | type == "string" and length > 0 and length <= 4096' \
    "$PROVIDER_RESPONSE" >/dev/null; then
    printf 'invalid-error-message\n'
  elif ! jq -e '(keys | length <= 16) and (.error | keys | length <= 16)' \
    "$PROVIDER_RESPONSE" >/dev/null; then
    printf 'too-many-keys\n'
  elif ! jq -e 'all(keys[]; test("^[A-Za-z0-9_-]{1,64}$"))
    and all(.error | keys[]; test("^[A-Za-z0-9_-]{1,64}$"))' \
    "$PROVIDER_RESPONSE" >/dev/null; then
    printf 'invalid-key\n'
  elif ! jq -e '((has("request_id") | not)
    or (.request_id | test("^req_[A-Za-z0-9]+$")))' \
    "$PROVIDER_RESPONSE" >/dev/null; then
    printf 'invalid-request-id\n'
  else
    printf 'compatible-error-envelope\n'
  fi
}

anthropic_error_envelope_is_compatible() {
  jq -e '
    has("type") and .type == "error" and has("error") and (.error | type == "object")
    and (.error | has("type")) and (.error | has("message"))
    and (.error.type | type == "string" and test("^[a-z_]{1,64}$"))
    and (.error.message | type == "string" and length > 0 and length <= 4096)
    and (keys | length <= 16) and (.error | keys | length <= 16)
    and all(keys[]; test("^[A-Za-z0-9_-]{1,64}$"))
    and all(.error | keys[]; test("^[A-Za-z0-9_-]{1,64}$"))
    and ((has("request_id") | not) or (.request_id | test("^req_[A-Za-z0-9]+$")))
  ' "$PROVIDER_RESPONSE" >/dev/null
}

poweroff_guest() {
  sync
  systemctl reboot --force --force >/dev/null 2>&1 || reboot -f
}

finish() {
  local rc=$?
  local credential_cleanup_failed=0
  set +e
  remove_provider_credential || credential_cleanup_failed=1
  if $RESULT_MOUNTED; then
    if [[ "$credential_cleanup_failed" -ne 0 ]]; then
      find /result -mindepth 1 -maxdepth 1 -exec rm -rf -- {} +
      rc=1
    elif [[ "$STATUS" != success ]]; then
      printf '%s\n' "$FAILURE" > /result/status
    fi
    sync /result
  fi
  $WEBROOT_MOUNTED && umount /var/www/html
  $WORK_MOUNTED && umount /work
  $INPUT_MOUNTED && umount /input
  $RESULT_MOUNTED && umount /result
  poweroff_guest
  exit "$rc"
}
trap finish EXIT

for label in ETA_INPUT ETA_WORK ETA_RESULT; do
  for _ in $(seq 1 100); do
    [[ -e "/dev/disk/by-label/$label" ]] && break
    sleep 0.05
  done
  [[ -e "/dev/disk/by-label/$label" ]] || {
    FAILURE="missing-drive-$label"
    exit 1
  }
done

install -d -m 0755 /input /work /result
mount -o ro,nosuid,nodev,noexec /dev/disk/by-label/ETA_INPUT /input
INPUT_MOUNTED=true
mount -o rw,nosuid,nodev,context=system_u:object_r:httpd_sys_content_t:s0 \
  /dev/disk/by-label/ETA_WORK /work
WORK_MOUNTED=true
chown factory-agent:factory-agent /work
mount -o rw,nosuid,nodev,noexec /dev/disk/by-label/ETA_RESULT /result
RESULT_MOUNTED=true

MANIFEST=/input/run.json
jq -e '
  .schema_version == 1
  and (.run_id | test("^[a-z0-9][a-z0-9-]{0,62}$"))
  and (.base_sha | test("^[0-9a-f]{40}$"))
  and (.source_archive_sha256 | test("^[0-9a-f]{64}$"))
  and (.request_sha256 | test("^[0-9a-f]{64}$"))
  and (.snapshot_sql_sha256 | test("^[0-9a-f]{64}$"))
  and (.snapshot_manifest_sha256 | test("^[0-9a-f]{64}$"))
  and (if .credential_required then
    (.host_contract_sha256 | test("^[0-9a-f]{64}$"))
  else true end)
  and (.mode == "fixture" or .mode == "provider-qualification" or .mode == "adversarial-qualification")
  and (if .mode == "adversarial-qualification" then
    (.qualification_manifest_sha256 | test("^[0-9a-f]{64}$"))
    and (.canary_sha256 | test("^[0-9a-f]{64}$"))
  else true end)
' "$MANIFEST" >/dev/null

RUN_ID=$(jq -r .run_id "$MANIFEST")
BASE_SHA=$(jq -r .base_sha "$MANIFEST")
REQUEST_SHA=$(jq -r .request_sha256 "$MANIFEST")
SNAPSHOT_SQL_SHA=$(jq -r .snapshot_sql_sha256 "$MANIFEST")
SNAPSHOT_MANIFEST_SHA=$(jq -r .snapshot_manifest_sha256 "$MANIFEST")
PROVIDER=$(jq -r .provider "$MANIFEST")
MODE=$(jq -r .mode "$MANIFEST")
HOST_CONTRACT_SHA=$(jq -r '.host_contract_sha256 // empty' "$MANIFEST")
IMAGE_MANIFEST=/input/image.json
jq -e '
  .schema_version == 1
  and (.rootfs_sha256 | test("^[0-9a-f]{64}$"))
  and (.image_recipe_sha256 | test("^[0-9a-f]{64}$"))
  and (.production_parity_sha256 | test("^[0-9a-f]{64}$"))
' "$IMAGE_MANIFEST" >/dev/null
ROOTFS_SHA=$(jq -r .rootfs_sha256 "$IMAGE_MANIFEST")
IMAGE_RECIPE_SHA=$(jq -r .image_recipe_sha256 "$IMAGE_MANIFEST")
PRODUCTION_PARITY_SHA=$(jq -r .production_parity_sha256 "$IMAGE_MANIFEST")

[[ "$(sha256sum /input/request.md | cut -d' ' -f1)" == "$REQUEST_SHA" ]]
[[ "$(sha256sum /input/snapshot.sql.gz | cut -d' ' -f1)" == "$SNAPSHOT_SQL_SHA" ]]
[[ "$(sha256sum /input/snapshot.json | cut -d' ' -f1)" == "$SNAPSHOT_MANIFEST_SHA" ]]
[[ "$(</work/.patchyard-base-sha)" == "$BASE_SHA" ]]
[[ -d /work/.git ]]
WORK_REMOTES=$(runuser -u factory-agent -- git -C /work remote)
WORK_STATUS=$(runuser -u factory-agent -- git -C /work status --porcelain)
[[ -z "$WORK_REMOTES" ]]
[[ -z "$WORK_STATUS" ]]

if [[ -s /input/provider-hosts ]]; then
  while read -r address hostname extra; do
    [[ -z "${extra:-}" ]]
    [[ "$address" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]
    [[ "$hostname" =~ ^[a-z0-9.-]+$ ]]
    printf '%s %s\n' "$address" "$hostname" >>/etc/hosts
  done </input/provider-hosts
fi

CREDENTIAL_REQUIRED=$(jq -r .credential_required "$MANIFEST")
CREDENTIAL_DRIVE_READ_ONLY=false
if [[ "$CREDENTIAL_REQUIRED" == true ]]; then
  [[ -e /dev/disk/by-label/ETA_CREDENTIAL ]]
  CREDENTIAL_DEVICE=$(readlink -f -- /dev/disk/by-label/ETA_CREDENTIAL)
  [[ "$CREDENTIAL_DEVICE" == /dev/* ]]
  [[ "$(blockdev --getro "$CREDENTIAL_DEVICE")" == 1 ]]
  install -d -m 0700 /credential /run/patchyard-capability
  mount -o ro,nosuid,nodev,noexec "$CREDENTIAL_DEVICE" /credential
  findmnt -n -o OPTIONS /credential | tr ',' '\n' | grep -Fxq ro
  if touch /credential/write-probe 2>/dev/null; then
    FAILURE=credential-drive-writable
    exit 1
  fi
  CREDENTIAL_DRIVE_READ_ONLY=true
  install -m 0400 -o factory-agent -g factory-agent \
    /credential/capability.json /run/patchyard-capability/capability.json
  umount /credential
  CAPABILITY_FILE=/run/patchyard-capability/capability.json
fi

if [[ "$MODE" == adversarial-qualification ]]; then
  [[ "$PROVIDER" == openai && "$CREDENTIAL_REQUIRED" == false ]]
  [[ -f /work/base.txt ]]
  QUALIFICATION_MANIFEST=/input/hostile-test-manifest.json
  QUALIFICATION_MANIFEST_SHA=$(jq -r .qualification_manifest_sha256 "$MANIFEST")
  CANARY_SHA=$(jq -r .canary_sha256 "$MANIFEST")
  [[ -f "$QUALIFICATION_MANIFEST" && ! -L "$QUALIFICATION_MANIFEST" ]]
  [[ "$(sha256sum "$QUALIFICATION_MANIFEST" | cut -d' ' -f1)" \
    == "$QUALIFICATION_MANIFEST_SHA" ]]

  FAILURE=adversarial-qualification-probe-failed
  if ! /usr/local/sbin/patchyard-hostile-probe \
    "$QUALIFICATION_MANIFEST" "$CANARY_SHA" \
    /run/session5-guest-results.json; then
    FAILED_TEST=$(jq -r \
      '[.[] | select(.status != "PASS") | .id | ascii_downcase][0] // "unknown"' \
      /run/session5-guest-results.json 2>/dev/null || true)
    [[ "$FAILED_TEST" =~ ^[a-z0-9-]{1,32}$ ]] || FAILED_TEST=unknown
    # Preserve only the fixed four-entry internal result shape so the host can
    # report the bounded failed-test ID without accepting any guest output.
    : >/result/change.patch
    printf 'Session 5 qualification failed closed.\n' >/result/rationale.txt
    printf '{}\n' >/result/evidence.json
    FAILURE="adversarial-qualification-failed-$FAILED_TEST"
    exit 1
  fi

  FAILURE=adversarial-qualification-patch-failed
  printf 'session-5-hostile-qualification\n' >/work/session5-qualified.txt
  chown factory-agent:factory-agent /work/session5-qualified.txt
  runuser -u factory-agent -- git -C /work add -N .
  runuser -u factory-agent -- git -C /work diff --binary --full-index \
    >/result/change.patch
  [[ -s /result/change.patch ]]
  printf '%s\n' \
    'Exercised the enumerated Session 5 hostile-test manifest inside the production Firecracker image; the host independently qualified the result parser and teardown boundary.' \
    >/result/rationale.txt

  FAILURE=adversarial-qualification-evidence-failed
  PATCH_SHA=$(sha256sum /result/change.patch | cut -d' ' -f1)
  GUEST_RESULTS=$(jq -c . /run/session5-guest-results.json)
  jq -n \
    --arg run_id "$RUN_ID" \
    --arg base_sha "$BASE_SHA" \
    --arg request_sha256 "$REQUEST_SHA" \
    --arg provider "$PROVIDER" \
    --arg patch_sha256 "$PATCH_SHA" \
    --arg rootfs_sha256 "$ROOTFS_SHA" \
    --arg image_recipe_sha256 "$IMAGE_RECIPE_SHA" \
    --arg production_parity_sha256 "$PRODUCTION_PARITY_SHA" \
    --arg qualification_manifest_sha256 "$QUALIFICATION_MANIFEST_SHA" \
    --argjson session5_guest_results "$GUEST_RESULTS" \
    '{
      schema_version: 1,
      run_id: $run_id,
      base_sha: $base_sha,
      request_sha256: $request_sha256,
      provider: $provider,
      patch_sha256: $patch_sha256,
      rootfs_sha256: $rootfs_sha256,
      image_recipe_sha256: $image_recipe_sha256,
      production_parity_sha256: $production_parity_sha256,
      git_remote_count: 0,
      credential_removed_before_output: true,
      qualification_manifest_sha256: $qualification_manifest_sha256,
      session5_guest_results: $session5_guest_results
    }' >/result/evidence.json
  printf 'success\n' >/result/status
  STATUS=success
  FAILURE=
  exit 0
fi

if [[ "$MODE" == provider-qualification && "$PROVIDER" == anthropic ]] \
  && jq -e '.qualification_requirement == "provider-spend-enforcement"' \
    "$CAPABILITY_FILE" >/dev/null; then
  [[ "$CREDENTIAL_REQUIRED" == true && -n "$CAPABILITY_FILE" ]]
  [[ -f /work/base.txt ]]
  [[ "$CREDENTIAL_DRIVE_READ_ONLY" == true ]]
  if mountpoint -q /credential; then
    FAILURE=credential-drive-still-mounted
    exit 1
  fi
  jq -e '
    (keys | sort) == ["authorization_ruling","capability_id","exchange_request_id",
      "expires_at","expires_in","issued_at","provider","qualification_phase",
      "qualification_requirement","rule_id","schema_version","scope","secret",
      "service_account_id","spend_cap_cents","token_type","workspace_id"]
    and .schema_version == 1 and .provider == "anthropic"
    and .qualification_requirement == "provider-spend-enforcement"
    and .authorization_ruling == "A115"
    and ((.qualification_phase == "temporary_refusal" and .spend_cap_cents == 100)
      or ((.qualification_phase == "operational_acceptance"
        or .qualification_phase == "restored_acceptance")
        and .spend_cap_cents == 5000))
    and (.secret | test("^sk-ant-oat01-[A-Za-z0-9_-]+$") and length <= 8192)
    and .token_type == "Bearer"
    and .scope == "workspace:inference"
    and (.expires_in >= 60 and .expires_in <= 300)
  ' "$CAPABILITY_FILE" >/dev/null
  [[ "$(jq -r .qualification_phase "$CAPABILITY_FILE")" \
    == "$(jq -r .qualification_phase "$MANIFEST")" ]]
  [[ "$(jq -r .authorization_ruling "$CAPABILITY_FILE")" \
    == "$(jq -r .authorization_ruling "$MANIFEST")" ]]

  ISSUED_AT=$(jq -r .issued_at "$CAPABILITY_FILE")
  EXPIRES_AT=$(jq -r .expires_at "$CAPABILITY_FILE")
  EXPIRES_IN=$(jq -r .expires_in "$CAPABILITY_FILE")
  EXCHANGE_REQUEST_ID=$(jq -r .exchange_request_id "$CAPABILITY_FILE")
  SERVICE_ACCOUNT_ID=$(jq -r .service_account_id "$CAPABILITY_FILE")
  RULE_ID=$(jq -r .rule_id "$CAPABILITY_FILE")
  WORKSPACE_ID=$(jq -r .workspace_id "$CAPABILITY_FILE")
  SPEND_CAP_CENTS=$(jq -r .spend_cap_cents "$CAPABILITY_FILE")
  QUALIFICATION_PHASE=$(jq -r .qualification_phase "$CAPABILITY_FILE")
  PROVIDER_TEMP=/run/patchyard-provider
  install -d -m 0700 -o factory-agent -g factory-agent "$PROVIDER_TEMP"
  AUTH_CONFIG="$PROVIDER_TEMP/anthropic-curl.conf"
  PROVIDER_HEADERS="$PROVIDER_TEMP/messages.headers"
  PROVIDER_RESPONSE="$PROVIDER_TEMP/messages.json"
  PROMPT_TEXT="$PROVIDER_TEMP/prompt.txt"
  PROVIDER_REQUEST="$PROVIDER_TEMP/request.json"
  {
    printf 'header = "Authorization: Bearer %s"\n' "$(jq -r .secret "$CAPABILITY_FILE")"
    printf 'header = "anthropic-version: 2023-06-01"\n'
    printf 'header = "content-type: application/json"\n'
  } >"$AUTH_CONFIG"
  chown factory-agent:factory-agent "$AUTH_CONFIG"
  chmod 0400 "$AUTH_CONFIG"
  printf '%s\n' \
    'Patchyard Factory spend-cap denial probe. Reply with one character.' \
    >"$PROMPT_TEXT"
  jq -Rs '{model:"claude-opus-5",max_tokens:1,
    messages:[{role:"user",content:.}]}' "$PROMPT_TEXT" >"$PROVIDER_REQUEST"
  chown factory-agent:factory-agent "$PROMPT_TEXT" "$PROVIDER_REQUEST"
  chmod 0400 "$PROMPT_TEXT" "$PROVIDER_REQUEST"
  PROVIDER_REQUEST_SHA256=$(sha256sum "$PROVIDER_REQUEST" | cut -d' ' -f1)

  FAILURE=anthropic-spend-provider-call-not-completed
  PROVIDER_OBSERVATION=
  PROVIDER_CURL_EXIT=0
  # A115_PROVIDER_REQUEST_BEGIN
  PROVIDER_STATUS=$(runuser -u factory-agent -- curl \
    --config "$AUTH_CONFIG" --silent --show-error \
    --connect-timeout 10 --max-time 60 \
    --dump-header "$PROVIDER_HEADERS" \
    --output "$PROVIDER_RESPONSE" --write-out '%{http_code}' \
    --data-binary "@$PROVIDER_REQUEST" \
    'https://api.anthropic.com/v1/messages') || PROVIDER_CURL_EXIT=$?
  # A115_PROVIDER_REQUEST_END
  if [[ "$PROVIDER_CURL_EXIT" -ne 0 ]]; then
    [[ "$PROVIDER_CURL_EXIT" =~ ^[1-9][0-9]?$ ]] || PROVIDER_CURL_EXIT=unknown
    FAILURE="anthropic-provider-transport-failed-$PROVIDER_CURL_EXIT"
    exit 1
  fi
  PROVIDER_REQUEST_ID=$(awk 'tolower($1) == "request-id:" {gsub("\r", "", $2); print $2; exit}' \
    "$PROVIDER_HEADERS")
  [[ "$PROVIDER_REQUEST_ID" =~ ^req_[A-Za-z0-9]+$ ]]
  PROVIDER_SERVER_DATE=$(awk 'tolower($1) == "date:" {
    sub(/^[^:]+:[[:space:]]*/, ""); sub(/\r$/, ""); print; exit
  }' "$PROVIDER_HEADERS")
  if [[ -z "$PROVIDER_SERVER_DATE" ]]; then
    FAILURE="anthropic-spend-provider-response-rejected-$PROVIDER_STATUS-missing-date"
    exit 1
  fi
  if ! OBSERVED_AT=$(date -u -d "$PROVIDER_SERVER_DATE" +%Y-%m-%dT%H:%M:%SZ); then
    FAILURE="anthropic-spend-provider-response-rejected-$PROVIDER_STATUS-invalid-date"
    exit 1
  fi
  FAILURE=anthropic-spend-provider-response-rejected
  if [[ "$PROVIDER_STATUS" == 200 ]]; then
    if ! jq -e '
      .type == "message" and .model == "claude-opus-5"
      and (.usage.input_tokens | type == "number" and . >= 1)
      and (.usage.output_tokens | type == "number" and . >= 1)
    ' "$PROVIDER_RESPONSE" >/dev/null; then
      FAILURE=anthropic-spend-provider-response-rejected-200-invalid-message-envelope
      exit 1
    fi
    if [[ "$QUALIFICATION_PHASE" == temporary_refusal ]]; then
      FAILURE=anthropic-spend-temporary-cap-refusal-not-observed
      exit 1
    fi
    PROVIDER_OBSERVATION=$(jq -nc \
      --arg observed_at "$OBSERVED_AT" --arg request_id "$PROVIDER_REQUEST_ID" \
      --arg request_body_sha256 "$PROVIDER_REQUEST_SHA256" \
      --argjson expected_workspace_cap_cents "$SPEND_CAP_CENTS" \
      --argjson input_tokens "$(jq -r .usage.input_tokens "$PROVIDER_RESPONSE")" \
      --argjson output_tokens "$(jq -r .usage.output_tokens "$PROVIDER_RESPONSE")" \
      '{outcome:"accepted",endpoint:"/v1/messages",http_status:200,$observed_at,
        $request_id,$request_body_sha256,response_type:"message",
        model:"claude-opus-5",request_attempts:1,
        $expected_workspace_cap_cents,usage:{$input_tokens,$output_tokens}}')
  elif [[ "$QUALIFICATION_PHASE" == temporary_refusal \
    && "$PROVIDER_STATUS" =~ ^(400|403)$ ]] \
    && anthropic_error_envelope_is_compatible; then
    BODY_REQUEST_ID=$(jq -r '.request_id // empty' "$PROVIDER_RESPONSE")
    if [[ -n "$BODY_REQUEST_ID" && "$BODY_REQUEST_ID" != "$PROVIDER_REQUEST_ID" ]]; then
      FAILURE="anthropic-spend-provider-response-rejected-$PROVIDER_STATUS-request-id-mismatch"
      exit 1
    fi
    ERROR_TYPE=$(jq -r .error.type "$PROVIDER_RESPONSE")
    if [[ "$ERROR_TYPE" == rate_limit_error || "$ERROR_TYPE" == overloaded_error ]]; then
      FAILURE="anthropic-spend-provider-response-rejected-$PROVIDER_STATUS-$ERROR_TYPE"
      FAILURE=${FAILURE//_/-}
      exit 1
    fi
    ERROR_MESSAGE_SHA256=$(jq -jr .error.message "$PROVIDER_RESPONSE" | sha256sum | cut -d' ' -f1)
    if jq -e '.error.message | test("(spend|credit|billing|monthly (spend|usage) limit)"; "i")' \
      "$PROVIDER_RESPONSE" >/dev/null; then
      MESSAGE_CLASS=spend_attributable
    else
      MESSAGE_CLASS=unattributed
    fi
    TOP_LEVEL_KEYS=$(jq -c 'keys | sort' "$PROVIDER_RESPONSE")
    ERROR_KEYS=$(jq -c '.error | keys | sort' "$PROVIDER_RESPONSE")
    PROVIDER_OBSERVATION=$(jq -nc \
      --arg observed_at "$OBSERVED_AT" --arg request_id "$PROVIDER_REQUEST_ID" \
      --arg request_body_sha256 "$PROVIDER_REQUEST_SHA256" \
      --arg response_type "$(jq -r .type "$PROVIDER_RESPONSE")" \
      --arg error_type "$ERROR_TYPE" --arg message_class "$MESSAGE_CLASS" \
      --arg message_sha256 "$ERROR_MESSAGE_SHA256" \
      --argjson top_level_keys "$TOP_LEVEL_KEYS" --argjson error_keys "$ERROR_KEYS" \
      --argjson expected_workspace_cap_cents "$SPEND_CAP_CENTS" \
      --argjson http_status "$PROVIDER_STATUS" \
      '{outcome:"refused",endpoint:"/v1/messages",$http_status,$observed_at,
        $request_id,$request_body_sha256,$response_type,request_attempts:1,
        $expected_workspace_cap_cents,
        provider_error:{$error_type,$message_class,$message_sha256,
          shape:{$top_level_keys,$error_keys}}}')
  else
    [[ "$PROVIDER_STATUS" =~ ^[0-9]{3}$ ]] || PROVIDER_STATUS=unknown
    RESPONSE_SHAPE=$(classify_anthropic_error_shape)
    FAILURE="anthropic-spend-provider-response-rejected-$PROVIDER_STATUS-$RESPONSE_SHAPE"
    exit 1
  fi
  [[ -n "$PROVIDER_OBSERVATION" ]]
  remove_provider_credential

  FAILURE=anthropic-spend-qualification-patch-failed
  printf 'anthropic-provider-spend-enforcement-qualified\n' \
    >/work/anthropic-spend-qualified.txt
  chown factory-agent:factory-agent /work/anthropic-spend-qualified.txt
  runuser -u factory-agent -- git -C /work add -N .
  runuser -u factory-agent -- git -C /work diff --binary --full-index \
    >/result/change.patch
  [[ -s /result/change.patch ]]
  printf '%s\n' \
    'Ran exactly one A115 phase request with a fresh Patchyard Factory workspace bearer, removed the bearer, and published only the bounded provider observation.' \
    >/result/rationale.txt

  FAILURE=anthropic-spend-qualification-evidence-failed
  PATCH_SHA=$(sha256sum /result/change.patch | cut -d' ' -f1)
  jq -n \
    --arg run_id "$RUN_ID" --arg base_sha "$BASE_SHA" \
    --arg request_sha256 "$REQUEST_SHA" --arg patch_sha256 "$PATCH_SHA" \
    --arg observed_rootfs_sha256 "$ROOTFS_SHA" \
    --arg image_recipe_sha256 "$IMAGE_RECIPE_SHA" \
    --arg production_parity_sha256 "$PRODUCTION_PARITY_SHA" \
    --arg host_contract_sha256 "$HOST_CONTRACT_SHA" \
    --arg issued_at "$ISSUED_AT" --arg expires_at "$EXPIRES_AT" \
    --arg exchange_request_id "$EXCHANGE_REQUEST_ID" \
    --arg service_account_id "$SERVICE_ACCOUNT_ID" --arg rule_id "$RULE_ID" \
    --arg workspace_id "$WORKSPACE_ID" --argjson expires_in "$EXPIRES_IN" \
    --arg qualification_phase "$QUALIFICATION_PHASE" \
    --argjson provider_observation "$PROVIDER_OBSERVATION" \
