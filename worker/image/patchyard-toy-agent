#!/usr/bin/env bash
set -euo pipefail

REQUEST=${1:?request path required}
WORKTREE=${2:?worktree path required}

grep -Fxq 'Add the Session 4 parity probe page.' "$REQUEST"
cat >"$WORKTREE/mfieldbook/patchyard_session4_probe.php" <<'PHP'
<?php
require_once __DIR__ . '/system_specific/settings.php';
$db = new mysqli(DB_HOST, USERNAME, DB_PASSWORD, DB_NAME);
$result = $db->query('SELECT marker FROM etaFactoryParitySeed ORDER BY id LIMIT 1');
$row = $result->fetch_assoc();
header('Content-Type: text/plain');
echo "Session 4 factory worker|" . $row['marker'] . "\n";
PHP
printf '%s\n' 'Added one deterministic PHP parity endpoint that reads the per-run local MySQL seed.'
