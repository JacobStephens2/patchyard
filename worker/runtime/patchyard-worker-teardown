#!/usr/bin/env bash
set -euo pipefail

RUN_ID=${1:-}
REMOTE_ROOT=${2:-}
[[ "$RUN_ID" =~ ^[0-9a-f]{32}-a[01]$ ]]
[[ "$REMOTE_ROOT" == "/var/tmp/patchyard-incoming/$RUN_ID" ]]

mapfile -t LAUNCHERS < <(pgrep -f \
  "^(/usr/bin/bash )?/usr/local/sbin/patchyard-firecracker-run $REMOTE_ROOT/run.json " || true)
for pid in "${LAUNCHERS[@]}"; do kill -TERM "$pid" 2>/dev/null || true; done
for _ in $(seq 1 100); do
  remaining=false
  for pid in "${LAUNCHERS[@]}"; do kill -0 "$pid" 2>/dev/null && remaining=true; done
  ! $remaining && break
  sleep 0.05
done
for pid in "${LAUNCHERS[@]}"; do
  kill -KILL "$pid" 2>/dev/null || true
done
for pid in "${LAUNCHERS[@]}"; do
  kill -0 "$pid" 2>/dev/null && {
    echo "worker launcher survived teardown: $pid" >&2
    exit 1
  }
done
echo "worker runtime teardown complete: $RUN_ID"
